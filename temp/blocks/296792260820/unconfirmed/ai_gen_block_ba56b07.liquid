{% doc %}
  @prompt
    用图片填充的大号粗体文本。包括一个用于控制背景颜色的设置。
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-image-text__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    line-height: 1.1;
    margin: 0;
    background-image: url('{{ block.settings.fill_image | image_url: width: 2000 }}');
    background-size: cover;
    background-position: center;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .ai-image-text__placeholder-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    line-height: 1.1;
    margin: 0;
    color: #cccccc;
  }

  @media screen and (max-width: 749px) {
    .ai-image-text__heading-{{ ai_gen_id }},
    .ai-image-text__placeholder-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.font_size }}px * 0.6);
    }
  }
{% endstyle %}

<div class="ai-image-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.fill_image %}
    <h2 class="ai-image-text__heading-{{ ai_gen_id }}">
      {{ block.settings.text }}
    </h2>
  {% else %}
    <h2 class="ai-image-text__placeholder-{{ ai_gen_id }}">
      {{ block.settings.text }}
    </h2>
  {% endif %}
</div>

{% schema %}
{
  "name": "图片填充文本",
  "settings": [
    {
      "type": "header",
      "content": "文本"
    },
    {
      "type": "text",
      "id": "text",
      "label": "文本内容",
      "default": "大号粗体文本"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "字体大小",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "字体粗细",
      "options": [
        {
          "value": "400",
          "label": "正常"
        },
        {
          "value": "700",
          "label": "粗体"
        },
        {
          "value": "900",
          "label": "特粗"
        }
      ],
      "default": "900"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "文本对齐",
      "options": [
        {
          "value": "left",
          "label": "左对齐"
        },
        {
          "value": "center",
          "label": "居中"
        },
        {
          "value": "right",
          "label": "右对齐"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "填充图片"
    },
    {
      "type": "image_picker",
      "id": "fill_image",
      "label": "填充图片"
    },
    {
      "type": "header",
      "content": "样式"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "内边距",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "桌面宽度",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "图片填充文本"
    }
  ]
}
{% endschema %}
