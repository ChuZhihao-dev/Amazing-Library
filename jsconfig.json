{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "noImplicitReturns": false,
    "noImplicitThis": false,
    "skipLibCheck": true,
    "suppressImplicitAnyIndexErrors": true
  },
  "include": [
    "assets/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "**/*.ts"
  ]
}
