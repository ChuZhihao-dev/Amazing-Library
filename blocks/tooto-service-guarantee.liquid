{% assign block_settings = block.settings %}

<accordion-custom
  {% if block_settings.open_by_default %}
    open-by-default-on-desktop
    open-by-default-on-mobile
  {% endif %}
>
  <details
    class="tooto-service-guarantee"
    data-testid="tooto-service-guarantee"
    {% if block_settings.open_by_default %}
      open
    {% endif %}
    {{ block.shopify_attributes }}
  >
    <summary class="tooto-service-guarantee__summary">
      <div class="tooto-service-guarantee__summary-left">
        <span class="tooto-service-guarantee__heading">{{ block_settings.heading | escape }}</span>
        {% if block_settings.tooltip_text != blank %}
          <span class="tooto-service-guarantee__info-wrap">
            <span class="tooto-service-guarantee__info" tabindex="0" aria-label="More info">i</span>
            <span class="tooto-service-guarantee__tooltip">{{ block_settings.tooltip_text | escape }}</span>
          </span>
        {% endif %}
      </div>
      <span class="tooto-service-guarantee__caret" aria-hidden="true">
       {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    </summary>

    <div class="tooto-service-guarantee__content details-content">
      {% content_for 'blocks' %}
    </div>
  </details>
</accordion-custom>

{% stylesheet %}
  .tooto-service-guarantee {
    width: 100%;
  }

  .tooto-service-guarantee__summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0px 0 18px;
    cursor: pointer;
  }

  .tooto-service-guarantee__summary::-webkit-details-marker {
    display: none;
  }

  .tooto-service-guarantee__summary-left {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .tooto-service-guarantee__heading {
    font-size: 20px;
    line-height: 1.2;
    font-weight: 700;
    color: var(--color-foreground-heading);
  }

  .tooto-service-guarantee__info-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .tooto-service-guarantee__info {
    width: 17px;
    height: 17px;
    border: 1px solid #BCA68F;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    line-height: 1;
    font-weight: 400;
    color: #BCA68F;
    background: transparent;
    box-sizing: border-box;
  }

  .tooto-service-guarantee__tooltip {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 180px;
    max-width: 220px;
    padding: 10px 12px;
    border-radius: 4px;
    background: white;
    color: #000;
    box-shadow: 0 8px 20px rgb(var(--color-foreground-rgb) / 0.08);
    border: 1px solid rgb(var(--color-border-rgb) / 0.18);
    font-size: 12px;
    line-height: 1.5;
    font-weight: 400;
    text-align: left;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease;
    z-index: 2;
  }

  .tooto-service-guarantee__info-wrap:hover .tooto-service-guarantee__tooltip,
  .tooto-service-guarantee__info-wrap:focus-within .tooto-service-guarantee__tooltip {
    opacity: 1;
    visibility: visible;
  }

  .tooto-service-guarantee__caret {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
    color: var(--color-foreground-heading);
    flex-shrink: 0;
  }

  .tooto-service-guarantee[open] .tooto-service-guarantee__caret {
    transform: rotate(0deg);
  }

  .tooto-service-guarantee:not([open]) .tooto-service-guarantee__caret {
    transform: rotate(180deg);
  }

  .tooto-service-guarantee__content {
    padding: 8px 0 24px;
    display: grid;
    gap: 16px;
  }

  .tooto-service-guarantee__item {
    display: grid;
    grid-template-columns: 15px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
  }

  .tooto-service-guarantee__item-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #2C2C2C;
    width: 15px;
    height: 15px;
  }

  .tooto-service-guarantee__icon {
    display: block;
    width: 15px;
    height: 15px;
  }

  .tooto-service-guarantee__item-text {
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    color: #000;
  }

  @media screen and (max-width: 749px) {
    .tooto-service-guarantee__summary {
      padding: 8px 0;
    }

    .tooto-service-guarantee__heading {
      font-size: 14px;
    }

    .tooto-service-guarantee__item {
      grid-template-columns: 15px minmax(0, 1fr);
      gap: 6px;
    }

    .tooto-service-guarantee__item-text {
      font-size: 14px;
      line-height: 20px;
    }
    .tooto-service-guarantee__summary-left {
      gap: 4px;
    }
    .tooto-service-guarantee__info {
      width: 10px;
      height: 10px;
      font-size: 8px;
    }
    .tooto-service-guarantee__content {
      padding: 0;
      gap: 8px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tooto Service Guarantee",
  "tag": null,
  "blocks": [
    {
      "type": "_tooto-service-guarantee-item"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Service Guarantee:"
    },
    {
      "type": "textarea",
      "id": "tooltip_text",
      "label": "Tooltip Text",
      "default": "Helpful information about your service guarantee."
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": true
    }
  ]
}
{% endschema %}
