

{% capture submit_button %}
  {% content_for 'block', type: 'contact-form-submit-button', id: 'submit-button' %}
{% endcapture %}

<div
  class="
    contact-form
    spacing-style size-style
    {% if block.settings.inherit_color_scheme == false %}color-{{ block.settings.color_scheme }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: block.settings %}
    {% render 'size-style', settings: block.settings %}
  "
  {{ block.shopify_attributes }}
>
  <h1 class="contact-form__title">Contact Us</h1>

  {% assign form_id = block.id | default: section.id | prepend: 'ContactForm-' %}
  {%- assign show_success_feedback = form.posted_successfully? -%}
  {%- form 'contact', id: form_id, class: 'contact-form__form' -%}
    <input
      name="contact[id]"
      type="hidden"
      value="{{ form_id }}"
    >

    {%- if form.errors -%}
      <div
        class="contact-form__feedback contact-form__feedback--error"
        tabindex="-1"
        autofocus
        role="alert"
      >
        <span class="contact-form__feedback-icon">
          {{- 'icon-error.svg' | inline_asset_content -}}
        </span>
        <div class="contact-form__feedback-content">
          <p class="contact-form__feedback-title">There was a problem submitting your message.</p>
          <p class="contact-form__feedback-text">
            {{- form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email -}}
          </p>
        </div>
      </div>
    {%- endif -%}

    <div
      class="contact-form__feedback contact-form__feedback--success{% unless show_success_feedback %} contact-form__feedback--hidden{% endunless %}"
      data-contact-success-message
      tabindex="-1"
      {% if show_success_feedback %}
        autofocus
      {% else %}
        hidden
      {% endif %}
      role="status"
    >
      <span class="contact-form__feedback-icon">
        {{- 'icon-checkmark.svg' | inline_asset_content -}}
      </span>
      <div class="contact-form__feedback-content">
        <p class="contact-form__feedback-title">Your message has been submitted successfully.</p>
        <p class="contact-form__feedback-text">Thank you — we’ll get back to you as soon as possible.</p>
      </div>
    </div>

    <div class="contact-form__form-row">
      <label class="visually-hidden" for="ContactForm-name">
        {{- 'blocks.contact_form.name' | t -}}
      </label>
      <input
        type="text"
        id="ContactForm-name"
        class="contact-form__input"
        autocomplete="name"
        name="contact[name]"
        value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
        placeholder="Your name"
      >

      <label class="visually-hidden" for="ContactForm-email">
        {{- 'blocks.contact_form.email' | t -}}
        <span aria-hidden="true">*</span>
      </label>
      <input
        type="email"
        id="ContactForm-email"
        class="contact-form__input"
        autocomplete="email"
        name="contact[email]"
        spellcheck="false"
        autocapitalize="off"
        value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
        aria-required="true"
        {% if form.errors contains 'email' %}
          aria-invalid="true"
          aria-describedby="ContactForm-email-error"
        {% endif %}
        placeholder="Your E-mail"
      >
    </div>

    <label class="visually-hidden" for="ContactForm-body">
      {{- 'blocks.contact_form.comment' | t -}}
    </label>
    <textarea
      rows="10"
      id="ContactForm-body"
      class="contact-form__input contact-form__input--textarea"
      name="contact[body]"
      placeholder="Your Message"
    >
      {{- form.body -}}
    </textarea>

    {{ submit_button }}
  {%- endform -%}

  <script>
    (function () {
      const formEl = document.getElementById('{{ form_id }}');
      if (!formEl) return;

      const successEl = formEl.querySelector('[data-contact-success-message]');
      if (!(successEl instanceof HTMLElement)) return;

      const url = new URL(window.location.href);
      const isPosted = url.searchParams.get('contact_posted') === 'true';
      const hashMatches = window.location.hash === '#{{ form_id }}';

      if (!isPosted || !hashMatches) return;

      successEl.hidden = false;
      successEl.classList.remove('contact-form__feedback--hidden');

      requestAnimationFrame(function () {
        try {
          successEl.focus();
        } catch (error) {
          console.warn('Contact form success focus failed', error);
        }
      });
    })();
  </script>
</div>

{% stylesheet %}

  .contact-form__title {
    font-size: 56px;
    font-weight: 700;
    color: #ffffff;
    text-align: center;
    margin-bottom: 36px;
  }

  .contact-form__form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .contact-form__form-row {
    display: flex;
    flex-direction: column;
    gap: 16px;

    @media screen and (min-width: 750px) {
      flex-direction: row;
      align-items: stretch;
      gap: 16px;
    }
  }



  input.contact-form__input,
  textarea.contact-form__input {
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #1a1a1a;
    background-color: #ffffff;
    padding: 20px 24px;
    border-radius: 0;
    border: 1px solid transparent;
    -webkit-font-smoothing: antialiased;
    font-size: 16px;
    outline: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .contact-form__input::placeholder {
    color: #060002;
  }

  .contact-form__input:focus {
    border-color: #999999;
    outline: none;
  }

  .contact-form__input--textarea {
    resize: vertical;
    min-height: 180px;
  }

  .contact-form .submit-button {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 100% !important;
    padding: 16px 20px;
    font-size: 20px;
    line-height: 28px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s ease;
    background-color: #F5F5EF;
    color: #000;
    margin-top: 14px;
  }

  .contact-form .submit-button:hover {
    opacity: 0.85;
  }

  .contact-form__feedback {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px 18px;
    margin-bottom: 16px;
    border: 1px solid transparent;
  }

  .contact-form__feedback--hidden {
    display: none;
  }

  .contact-form__feedback--success {
    background-color: #F5F5EF;
    border-color: #D9D9D0;
    color: #060002;
  }

  .contact-form__feedback--error {
    background-color: #FFF1F1;
    border-color: #F1B8B8;
    color: #8A1F1F;
  }

  .contact-form__feedback-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin-top: 2px;
  }

  .contact-form__feedback-icon svg {
    width: 20px;
    height: 20px;
  }

  .contact-form__feedback-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .contact-form__feedback-title {
    margin: 0;
    font-size: 16px;
    line-height: 1.4;
    font-weight: 600;
  }

  .contact-form__feedback-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
  }
  @media(max-width: 768px) {
    .contact-form__title {
      font-size: 28px;
      line-height: 36px;
      margin-bottom: 16px;
    }
    input.contact-form__input, textarea.contact-form__input {
      padding: 10px;
      font-size: 13px;
    }
   .contact-form__input--textarea {
      min-height: 130px;
      height: 130px;
    }
    .contact-form__form-row {
      flex-direction: row;
      gap: 6px;
    }
    .contact-form__form {
      gap: 6px;
    }
    .contact-form .submit-button {
      padding: 9px;
      font-size: 13px;
      line-height: 17px;
      margin-top: 10px;
    }
    .contact-form__feedback {
      gap: 10px;
      padding: 12px;
      margin-bottom: 12px;
    }
    .contact-form__feedback-title {
      font-size: 13px;
      line-height: 1.4;
    }
    .contact-form__feedback-text {
      font-size: 12px;
      line-height: 1.5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.contact_form",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.contact_form",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}
