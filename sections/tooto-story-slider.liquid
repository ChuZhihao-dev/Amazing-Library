{%- liquid
  assign card_img_widths = '400, 600, 900'
  assign card_img_sizes = '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  id="tooto-story-slider-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} tooto-story-slider"
  style="padding-block-start: {{ section.settings.padding-block-start }}px; padding-block-end: {{ section.settings.padding-block-end }}px;"
>
  <div class="tooto-story-slider__inner">

    {%- comment -%} ── Header：居中标题 ── {%- endcomment -%}
    <div class="tooto-story-slider__header">
      <h2 class="tooto-story-slider__heading">
        {{ section.settings.heading | escape }}
      </h2>
    </div>

    {%- comment -%} ── Swiper 轮播区（全宽，图片无间距）── {%- endcomment -%}
    <div class="swiper tooto-story-slider__swiper">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          <div class="swiper-slide tooto-story-slider__slide" {{ block.shopify_attributes }}>
            <div class="tooto-story-slider__image-wrapper">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    widths: card_img_widths,
                    sizes: card_img_sizes,
                    alt: block.settings.image.alt,
                    loading: 'lazy',
                    class: 'tooto-story-slider__image'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'tooto-story-slider__image tooto-story-slider__image--placeholder' }}
              {%- endif -%}

              {%- comment -%} 图片底部叠加文字 {%- endcomment -%}
              {%- if block.settings.caption != blank -%}
                <div class="tooto-story-slider__caption">
                  <span class="tooto-story-slider__caption-text">{{ block.settings.caption | escape }}</span>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} ── 底部：进度条 + More Story 按钮 ── {%- endcomment -%}
    <div class="tooto-story-slider__footer">
      <div class="tooto-story-slider__pagination" id="tooto-story-pagination-{{ section.id }}"></div>
      {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
        <a class="tooto-story-slider__cta" href="{{ section.settings.cta_url }}">
          {{ section.settings.cta_label | escape }}
        </a>
      {%- endif -%}
    </div>

  </div>
</div>

<script>
  (function () {
    const sectionEl = document.getElementById('tooto-story-slider-{{ section.id }}');
    if (!sectionEl) return;

    const paginationEl = document.getElementById('tooto-story-pagination-{{ section.id }}');
    const swiperEl = sectionEl.querySelector('.tooto-story-slider__swiper');

    new Swiper(swiperEl, {
      slidesPerView: 3,
      spaceBetween: 16,
      loop: false,
      slidesPerGroup: 1,
      centeredSlides: false,

      pagination: {
        el: paginationEl,
        clickable: true,
        renderBullet: function (index, className) {
          return '<button class="' + className + ' tooto-story-slider__dot" aria-label="Go to page ' + (index + 1) + '"></button>';
        },
      },

      breakpoints: {
        0: {
          slidesPerView: 1.4,
          spaceBetween: 8,
          slidesPerGroup: 1,
        },
        768: {
          slidesPerView: 2,
          spaceBetween: 16,
          slidesPerGroup: 1,
        },
        1024: {
          slidesPerView: 3,
          spaceBetween: 16,
          slidesPerGroup: 1,
        },
      },
    });
  })();
</script>

{% stylesheet %}

  .tooto-story-slider {
    padding-block: 48px !important;
  }
  /* ── 脱离主题 section grid ── */
  .tooto-story-slider__inner {
    grid-column: 1 / -1;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .section--page-width .tooto-story-slider__inner {
    grid-column: 2;
  }

  /* ── Header ── */
  .tooto-story-slider__header {
    text-align: center;
    padding-bottom: 64px;
  }

  .tooto-story-slider__heading {
    margin: 0;
    font-size: 56px;
    font-weight: 700;
    line-height: 64px;
    color: var(--color-foreground-heading);
  }

  .tooto-story-slider__heading strong {
    font-weight: 800;
  }

  /* ── Swiper 核心布局 ── */
  .tooto-story-slider__swiper {
    overflow: hidden;
    width: 100%;
    min-width: 0;
    position: relative;
  }

  .tooto-story-slider__swiper > .swiper-wrapper {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    box-sizing: content-box;
    position: relative;
    width: 100%;
    height: 100%;
    z-index: 1;
    will-change: transform;
  }

  .tooto-story-slider__swiper > .swiper-wrapper > .swiper-slide {
    flex-shrink: 0;
    width: 100%;
    height: auto;
    position: relative;
    display: block;
  }

  /* ── 图片 ── */
  .tooto-story-slider__image-wrapper {
    position: relative;
    aspect-ratio: 495 / 628;
    overflow: hidden;
  }

  .tooto-story-slider__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .tooto-story-slider__swiper .swiper-slide:hover .tooto-story-slider__image {
    transform: scale(1.04);
  }

  .tooto-story-slider__image--placeholder {
    width: 100%;
    height: 100%;
  }

  /* ── 图片底部叠加文字 ── */
  .tooto-story-slider__caption {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
  }

  .tooto-story-slider__caption-text {
    font-size: 24px;
    font-weight: 400;
    color: #fff;
    line-height: 1.3;
    display: block;
    max-width: 59%;
  }

  /* ── 底部区域 ── */
  .tooto-story-slider__footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding-top: 46px;
    padding-bottom: 56px;
  }

  /* ── 横线型进度条 ── */
  .tooto-story-slider__pagination {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .tooto-story-slider__pagination .tooto-story-slider__dot {
    width: 40px;
    height: 2px;
    border: none;
    border-radius: 2px;
    background-color: var(--color-foreground);
    opacity: 0.2;
    cursor: pointer;
    padding: 0;
    margin: 0 !important;
    transition: opacity 0.3s ease;
  }

  .tooto-story-slider__pagination .swiper-pagination-bullet-active.tooto-story-slider__dot {
    opacity: 1;
  }

  /* ── More Story 空心按钮 ── */
  .tooto-story-slider__cta {
    display: inline-block;
    padding: 11px 32px;
    border: 1.5px solid var(--color-foreground);
    color: var(--color-foreground);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .tooto-story-slider__cta:hover {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  /* ── 响应式 ── */
  @media (max-width: 768px) {
    .tooto-story-slider__heading {
      font-size: 28px;
      line-height: 32px;
    }
    .tooto-story-slider__header {
      padding: 32px;
    }

    .tooto-story-slider__caption-text {
      font-size: 13px;
      max-width: 50%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tooto Story Slider",
  "tag": "section",
  "class": "tooto-story-slider-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Woo Story"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "More Story"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Story Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (overlay text)",
          "default": "Suitable for medieval style"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tooto Story Slider",
      "settings": {
        "heading": "Woo Story",
        "cta_label": "More Story",
        "section_width": "full-width",
        "color_scheme": "scheme-2",
        "padding-block-start": 60,
        "padding-block-end": 60
      },
      "blocks": [
        { "type": "slide", "settings": { "caption": "Suitable for medieval style" } },
        { "type": "slide", "settings": { "caption": "Suitable for cream style" } },
        { "type": "slide", "settings": { "caption": "Suitable for modern minimalist style" } },
        { "type": "slide", "settings": { "caption": "Suitable for Nordic style" } }
      ]
    }
  ]
}
{% endschema %}