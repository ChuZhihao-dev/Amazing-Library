{%- liquid
  assign bg_widths = '750, 1100, 1500, 2000, 3000, 3840'
  assign bg_sizes = '100vw'
  assign section_height = section.settings.section_height
  if request.design_mode == false
    if section.settings.section_height_mobile != blank
      assign section_height_mobile = section.settings.section_height_mobile
    endif
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  id="tooto-series-hero-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} tooto-series-hero"
  style="padding-block-start: {{ section.settings.padding-block-start }}px; padding-block-end: {{ section.settings.padding-block-end }}px;"
>
  <div
    class="tooto-series-hero__inner"
    style="--section-height-desktop: {{ section.settings.section_height }}vh;"
    data-mobile-height="{{ section.settings.section_height_mobile }}"
  >
    {%- comment -%} 背景图 {%- endcomment -%}
    <div class="tooto-series-hero__bg">
      {%- comment -%} 桌面背景图 {%- endcomment -%}
      {%- if section.settings.image != blank -%}
        <picture>
          {%- comment -%} 移动端背景图（如果有配置） {%- endcomment -%}
          {%- if section.settings.image_mobile != blank -%}
            <source
              media="(max-width: 767px)"
              srcset="{{ section.settings.image_mobile | image_url: width: 1000 }}"
            >
          {%- endif -%}
          {%- comment -%} 桌面端背景图 {%- endcomment -%}
          {{
            section.settings.image
            | image_url: width: 2000
            | image_tag:
              widths: bg_widths,
              sizes: bg_sizes,
              alt: section.settings.image.alt,
              loading: 'eager',
              fetchpriority: 'high',
              class: 'tooto-series-hero__bg-image'
          }}
        </picture>
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'tooto-series-hero__bg-image tooto-series-hero__bg-image--placeholder' }}
      {%- endif -%}
    </div>

    {%- comment -%} 遮罩 {%- endcomment -%}
    {%- if section.settings.overlay_opacity > 0 -%}
      <div
        class="tooto-series-hero__overlay"
        style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
      ></div>
    {%- endif -%}

      {%- comment -%} 内容层：左下角标题 + 右下角描述 {%- endcomment -%}
      <div class="section"> 
        <div class="tooto-series-hero__content">
          {%- comment -%} 左下：系列名 {%- endcomment -%}
          <div class="tooto-series-hero__title-block">
            <h2 class="tooto-series-hero__heading">
              <span class="tooto-series-hero__heading-bold">{{ section.settings.heading_bold | escape }}</span>
              <span class="tooto-series-hero__heading-light">{{ section.settings.heading_light | escape }}</span>
            </h2>
          </div>

          {%- comment -%} 右下：描述 + CTA {%- endcomment -%}
          <div class="tooto-series-hero__desc-block">
            {%- if section.settings.description != blank -%}
              <p class="tooto-series-hero__description">{{ section.settings.description }}</p>
            {%- endif -%}
            {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
              <a class="tooto-series-hero__link" href="{{ section.settings.link_url }}">
                {{ section.settings.link_label | escape }} &rarr;
              </a>
            {%- endif -%}
          </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .tooto-series-hero__inner {
    grid-column: 1 / -1;
    position: relative;
    width: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    box-sizing: border-box;
    min-height: var(--section-height-desktop, 75vh);
  }

  .section--page-width .tooto-series-hero__inner {
    grid-column: 2;
  }

  /* ── 背景图 ── */
  .tooto-series-hero__bg {
    position: absolute;
    inset: 0;
  }

  .tooto-series-hero__bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tooto-series-hero__bg-image--placeholder {
    width: 100%;
    height: 100%;
  }

  /* ── 遮罩 ── */
  .tooto-series-hero__overlay {
    position: absolute;
    inset: 0;
    background-color: #000;
    pointer-events: none;
  }

  /* ── 内容层 ── */
  .tooto-series-hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: row;
    align-items: start;
    justify-content: space-between;
    gap: 40px;
    padding-bottom: 72px;
  }

  /* ── 左下：系列名 ── */
  .tooto-series-hero__heading {
    margin: 0;
    display: flex;
    flex-direction: column;
    line-height: 1.0;
  }

  .tooto-series-hero__heading-bold {
    font-size: 56px;
    font-weight: 800;
    color: var(--color-background);
    font-family: 'Manrope';
    display: block;
  }

  .tooto-series-hero__heading-light {
    font-size: 56px;
    font-weight: 300;
    color: var(--color-background);
    display: block;
    letter-spacing: 1px;
  }

  /* ── 右下：描述 + CTA ── */
  .tooto-series-hero__desc-block {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 488px;
    flex-shrink: 0;
  }

  .tooto-series-hero__description {
    font-size: 0.875rem;
    line-height: 1.65;
    margin: 0;
    color: var(--color-background);
    opacity: 0.9;
  }

  .tooto-series-hero__link {
    font-size: 0.8125rem;
    color: var(--color-background);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: opacity 0.2s ease;
    width: fit-content;
  }

  .tooto-series-hero__link:hover {
    opacity: 0.7;
  }

  /* ── 响应式 ── */
  @media (max-width: 767px) {
    .tooto-series-hero__inner {
      /* 由 JavaScript 动态设置 */
    }

    .tooto-series-hero__content {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding-bottom: 40px;
    }
    .tooto-series-hero__description {
      font-size: 13px;
      line-height: 17px;
    }
    .tooto-series-hero__heading-bold,
    .tooto-series-hero__heading-light {
      font-size: 28px;
      line-height: 32px;
    }

    .tooto-series-hero__desc-block {
      max-width: 100%;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    const sectionEl = document.getElementById('tooto-series-hero-{{ section.id }}');
    if (!sectionEl) return;

    const innerEl = sectionEl.querySelector('.tooto-series-hero__inner');
    if (!innerEl) return;

    const mobileHeight = innerEl.dataset.mobileHeight;
    // 保底：如果没有配置移动端高度，就不做任何处理（使用桌面端高度）
    if (!mobileHeight) return;

    // 创建媒体查询监听
    const mediaQuery = window.matchMedia('(max-width: 767px)');

    function applyHeight(isMobile) {
      if (isMobile) {
        innerEl.style.minHeight = mobileHeight + 'vh';
      } else {
        // 桌面端恢复原始样式（由 Liquid 设置）
        innerEl.style.minHeight = '';
      }
    }

    // 初始化
    applyHeight(mediaQuery.matches);

    // 响应窗口尺寸变化
    mediaQuery.addEventListener('change', (e) => {
      applyHeight(e.matches);
    });
  })();
</script>

{% schema %}
{
  "name": "Tooto Series Hero",
  "tag": "section",
  "class": "tooto-series-hero-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Background Image (Mobile)",
      "info": "Optional: If not set, desktop image will be used on mobile"
    },
    {
      "type": "text",
      "id": "heading_bold",
      "label": "Heading Bold Line",
      "default": "CityofGems"
    },
    {
      "type": "text",
      "id": "heading_light",
      "label": "Heading Light Line",
      "default": "Series"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Made from natural animal fibers, wool carpets offer a soft, skin-friendly touch and a warm, inviting feel. Their inherent elasticity reduces foot fatigue, making them ideal for bedrooms or children's rooms."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link Label",
      "default": "Shop More"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section Height - Desktop (vh)",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 75
    },
    {
      "type": "range",
      "id": "section_height_mobile",
      "label": "Section Height - Mobile (vh)",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 70
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Tooto Series Hero",
      "settings": {
        "heading_bold": "CityofGems",
        "heading_light": "Series",
        "link_label": "Shop More",
        "overlay_opacity": 20,
        "section_height": 75,
        "section_height_mobile": 70,
        "section_width": "full-width",
        "color_scheme": "scheme-1"
      }
    }
  ]
}
{% endschema %}