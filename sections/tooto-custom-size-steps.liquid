{%- liquid
  assign heading = section.settings.heading
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--page-width color-{{ section.settings.color_scheme }}"
  style="padding-block-start: {{ section.settings.padding-block-start }}px; padding-block-end: {{ section.settings.padding-block-end }}px;"
>
  <div class="tooto-custom-size-steps__inner">

    {%- if heading != blank -%}
      <h2 class="tooto-custom-size-steps__heading">{{ heading }}</h2>
    {%- endif -%}

    <div class="tooto-custom-size-steps__grid">
      {%- for block in section.blocks -%}
        <div class="tooto-custom-size-steps__card" {{ block.shopify_attributes }}>

          {%- comment -%} Icon {%- endcomment -%}
          <div class="tooto-custom-size-steps__icon">
            {%- if block.settings.custom_icon != blank -%}
              {%- liquid
                assign icon_widths = '40, 60, 80'
                assign icon_sizes = '50px'
              -%}
              {{
                block.settings.custom_icon
                | image_url: width: 80
                | image_tag:
                  widths: icon_widths,
                  sizes: icon_sizes,
                  alt: block.settings.custom_icon.alt,
                  loading: 'lazy',
                  class: 'tooto-custom-size-steps__icon-img'
              }}
            {%- else -%}
              {%- case block.settings.icon -%}
                {%- when 'pick' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"/>
                  </svg>
                {%- when 'feel' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="7" height="7"/>
                    <rect x="14" y="3" width="7" height="7"/>
                    <rect x="14" y="14" width="7" height="7"/>
                    <rect x="3" y="14" width="7" height="7"/>
                  </svg>
                {%- when 'measure' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 3h18v18H3z"/>
                    <path d="M9 9v6m6-6v6M6 9h12M6 15h12"/>
                  </svg>
                {%- when 'order' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V7"/>
                    <path d="M3 7h18M7 11h10M7 15h6"/>
                  </svg>
                {%- when 'enjoy' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12a7 7 0 1 0 14 0 7 7 0 1 0-14 0"/>
                    <path d="M8 14s1 2 4 2 4-2 4-2M9 9h.01M15 9h.01"/>
                  </svg>
              {%- endcase -%}
            {%- endif -%}
          </div>

          {%- comment -%} Title {%- endcomment -%}
          {%- if block.settings.title != blank -%}
            <h3 class="tooto-custom-size-steps__card-title">{{ block.settings.title }}</h3>
          {%- endif -%}

          {%- comment -%} Description {%- endcomment -%}
          {%- if block.settings.description != blank -%}
            <p class="tooto-custom-size-steps__card-description">{{ block.settings.description }}</p>
          {%- endif -%}

        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

{% stylesheet %}
  .tooto-custom-size-steps__inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
    grid-column: 2;
    width: 100%;
    box-sizing: border-box;
  }

  {%- comment -%} HEADING {%- endcomment -%}
  .tooto-custom-size-steps__heading {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--color-foreground);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  {%- comment -%} GRID {%- endcomment -%}
  .tooto-custom-size-steps__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 24px;
  }

  {%- comment -%} CARD {%- endcomment -%}
  .tooto-custom-size-steps__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  {%- comment -%} ICON {%- endcomment -%}
  .tooto-custom-size-steps__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    color: var(--color-foreground);
  }

  .tooto-custom-size-steps__icon-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  {%- comment -%} CARD TITLE {%- endcomment -%}
  .tooto-custom-size-steps__card-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-foreground);
    line-height: 1.4;
  }

  {%- comment -%} CARD DESCRIPTION {%- endcomment -%}
  .tooto-custom-size-steps__card-description {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-foreground);
    opacity: 0.7;
  }

  {%- comment -%} RESPONSIVE {%- endcomment -%}
  @media screen and (max-width: 1199px) {
    .tooto-custom-size-steps__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }

  @media screen and (max-width: 989px) {
    .tooto-custom-size-steps__inner {
      gap: 40px;
    }

    .tooto-custom-size-steps__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }

    .tooto-custom-size-steps__icon {
      width: 50px;
      height: 50px;
    }
  }

  @media screen and (max-width: 749px) {
    .tooto-custom-size-steps__inner {
      gap: 32px;
    }

    .tooto-custom-size-steps__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .tooto-custom-size-steps__heading {
      font-size: clamp(1.5rem, 5vw, 2rem);
    }

    .tooto-custom-size-steps__icon {
      width: 48px;
      height: 48px;
    }

    .tooto-custom-size-steps__card-title {
      font-size: 0.9375rem;
    }

    .tooto-custom-size-steps__card-description {
      font-size: 0.8125rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tooto Custom Size Steps",
  "tag": "section",
  "class": "tooto-custom-size-steps-wrapper",
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon (overrides built-in icon)"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Built-in Icon (fallback)",
          "options": [
            { "value": "pick",    "label": "Pick" },
            { "value": "feel",    "label": "Feel" },
            { "value": "measure", "label": "Measure" },
            { "value": "order",   "label": "Order" },
            { "value": "enjoy",   "label": "Enjoy" }
          ],
          "default": "pick"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Add your step description here."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How It Works"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Tooto Custom Size Steps",
      "settings": {
        "heading": "How It Works",
        "color_scheme": "scheme-1",
        "padding-block-start": 48,
        "padding-block-end": 48
      },
      "blocks": [
        {
          "type": "step",
          "settings": {
            "icon": "pick",
            "title": "Pick",
            "description": "Browse our curated rug collection and choose the style that best fits your space and taste."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "feel",
            "title": "Feel",
            "description": "Order a sample to feel the material and texture firsthand, ensuring it meets your expectations."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "measure",
            "title": "Measure",
            "description": "Measure your space accurately to provide precise dimensions for your custom rug."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "order",
            "title": "Order",
            "description": "Confirm dimensions and style, then place your custom order to start production."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "enjoy",
            "title": "Enjoy",
            "description": "Your custom rug is crafted and shipped within a week, ready to enhance your space."
          }
        }
      ]
    }
  ]
}
{% endschema %}