<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  id="tooto-footer-trust-bar-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} tooto-footer-trust-bar"
  style="padding-block-start: {{ section.settings.padding-block-start }}px; padding-block-end: {{ section.settings.padding-block-end }}px;"
>
  <div class="tooto-footer-trust-bar__inner">
    <ul class="tooto-footer-trust-bar__list">
      {%- for block in section.blocks -%}
        <li class="tooto-footer-trust-bar__item" {{ block.shopify_attributes }}>

          <span class="tooto-footer-trust-bar__icon">
            {%- if block.settings.custom_icon != blank -%}
              {%- liquid
                assign icon_widths = '32, 48, 64'
                assign icon_sizes = '20px'
              -%}
              {{
                block.settings.custom_icon
                | image_url: width: 64
                | image_tag:
                  widths: icon_widths,
                  sizes: icon_sizes,
                  alt: block.settings.custom_icon.alt,
                  loading: 'lazy',
                  class: 'tooto-footer-trust-bar__icon-img'
              }}
            {%- else -%}
              {%- case block.settings.icon -%}
                {%- when 'return' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="1 4 1 10 7 10"></polyline>
                    <path d="M3.51 15a9 9 0 1 0 .49-3.51"></path>
                  </svg>
                {%- when 'guarantee' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>
                {%- when 'shipping' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                  </svg>
                {%- when 'secure' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                  </svg>
              {%- endcase -%}
            {%- endif -%}
          </span>

          {%- if block.settings.label != blank -%}
            <span class="tooto-footer-trust-bar__label">{{ block.settings.label | escape }}</span>
          {%- endif -%}

        </li>

        {%- unless forloop.last -%}
          <li class="tooto-footer-trust-bar__divider" aria-hidden="true">/</li>
        {%- endunless -%}

      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .tooto-footer-trust-bar__inner {
    grid-column: 1 / -1;
    width: 100%;
    box-sizing: border-box;
  }

  .section--page-width .tooto-footer-trust-bar__inner {
    grid-column: 2;
  }

  .tooto-footer-trust-bar__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    width: 100%;
  }
  .tooto-footer-trust-bar__list::-webkit-scrollbar {
    display: none !important;
  }
  .tooto-footer-trust-bar__item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0;
    justify-content: center;
    min-width: 0;
  }

  .tooto-footer-trust-bar__icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    opacity: 0.85;
  }

  .tooto-footer-trust-bar__icon-img {
    width: 20px;
    height: 20px;
    object-fit: contain;
    display: block;
  }

  .tooto-footer-trust-bar__label {
    font-size: 16px;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--color-foreground);
    white-space: nowrap;
  }

  .tooto-footer-trust-bar__divider {
    color: var(--color-foreground);
    opacity: 0.35;
    font-size: 0.875rem;
    flex-shrink: 0;
    list-style: none;
    user-select: none;
  }

  @media (max-width: 749px) {
    .tooto-footer-trust-bar__list {
      gap: 38px;
      flex-wrap: nowrap;
      overflow-x: scroll;
    }
    .tooto-footer-trust-bar__list::-webkit-scrollbar {
      display: none;
      scrollbar-width: 0;
    }
    .tooto-footer-trust-bar__item {
      padding: 0;
      flex: none;
    }
    .tooto-footer-trust-bar__label {
      font-size: 13px;
      line-height: 17px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tooto Footer Trust Bar",
  "tag": "section",
  "class": "tooto-footer-trust-bar-wrapper",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top Padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom Padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon (overrides built-in icon)"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Built-in Icon (fallback)",
          "options": [
            { "value": "return",    "label": "Free Returns" },
            { "value": "guarantee", "label": "Guarantee" },
            { "value": "shipping",  "label": "Shipping" },
            { "value": "secure",    "label": "Secure Payment" }
          ],
          "default": "return"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Free Returns"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tooto Footer Trust Bar",
      "settings": {
        "section_width": "full-width",
        "color_scheme": "scheme-3",
        "padding-block-start": 18,
        "padding-block-end": 18
      },
      "blocks": [
        { "type": "trust_item", "settings": { "icon": "return",    "label": "Free Returns" } },
        { "type": "trust_item", "settings": { "icon": "guarantee", "label": "Satisfaction Guaranteed" } },
        { "type": "trust_item", "settings": { "icon": "shipping",  "label": "Free Shipping" } },
        { "type": "trust_item", "settings": { "icon": "secure",    "label": "Secure Payment" } }
      ]
    }
  ]
}
{% endschema %}