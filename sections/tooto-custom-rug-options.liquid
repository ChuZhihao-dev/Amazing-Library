{%- liquid
  assign heading = section.settings.heading
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--page-width color-{{ section.settings.color_scheme }}"
  style="padding-block-start: {{ section.settings.padding-block-start }}px; padding-block-end: {{ section.settings.padding-block-end }}px;"
>
  <div class="tooto-custom-rug-options__inner">

    {%- if heading != blank -%}
      <h2 class="tooto-custom-rug-options__heading">{{ heading }}</h2>
    {%- endif -%}

    <div class="tooto-custom-rug-options__grid">
      {%- for block in section.blocks -%}
        <div class="tooto-custom-rug-options__card" {{ block.shopify_attributes }}>

          {%- comment -%} Image {%- endcomment -%}
          <div class="tooto-custom-rug-options__image-wrapper">
            {%- if block.settings.image != blank -%}
              {%- liquid
                assign img_widths = '300, 400, 500, 600, 800'
                assign img_sizes = '(min-width: 1200px) calc((100vw - 80px) / 3), (min-width: 990px) calc((100vw - 60px) / 3), calc(100vw - 40px)'
              -%}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  widths: img_widths,
                  sizes: img_sizes,
                  alt: block.settings.image.alt | default: block.settings.title,
                  class: 'tooto-custom-rug-options__image',
                  loading: 'lazy'
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'tooto-custom-rug-options__image tooto-custom-rug-options__image--placeholder' }}
            {%- endif -%}
          </div>

          {%- comment -%} Icon {%- endcomment -%}
          <div class="tooto-custom-rug-options__icon">
            {%- if block.settings.custom_icon != blank -%}
              {%- liquid
                assign icon_widths = '30, 40, 50'
                assign icon_sizes = '40px'
              -%}
              {{
                block.settings.custom_icon
                | image_url: width: 50
                | image_tag:
                  widths: icon_widths,
                  sizes: icon_sizes,
                  alt: block.settings.custom_icon.alt,
                  loading: 'lazy',
                  class: 'tooto-custom-rug-options__icon-img'
              }}
            {%- else -%}
              {%- case block.settings.icon -%}
                {%- when 'measure' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 3h18v18H3z"/>
                    <path d="M8 8v8m8-8v8M5 8h14M5 16h14"/>
                  </svg>
                {%- when 'wall' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 9h12M6 13h12M6 17h12M3 5h18M3 21H3a2 2 0 01-2-2V5a2 2 0 012-2h18a2 2 0 012 2v14a2 2 0 01-2 2H3z"/>
                  </svg>
                {%- when 'special' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 1v6m0 6v6M1 12h6m6 0h6"/>
                    <circle cx="12" cy="12" r="10"/>
                  </svg>
              {%- endcase -%}
            {%- endif -%}
          </div>

          {%- comment -%} Title {%- endcomment -%}
          {%- if block.settings.title != blank -%}
            <h3 class="tooto-custom-rug-options__card-title">{{ block.settings.title }}</h3>
          {%- endif -%}

          {%- comment -%} Description {%- endcomment -%}
          {%- if block.settings.description != blank -%}
            <p class="tooto-custom-rug-options__card-description">{{ block.settings.description }}</p>
          {%- endif -%}

          {%- comment -%} Button {%- endcomment -%}
          {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
            <a href="{{ block.settings.button_link }}" class="tooto-custom-rug-options__button tooto-custom-rug-options__button--{{ block.settings.button_style }}">
              {{ block.settings.button_label }}
            </a>
          {%- endif -%}

        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

{% stylesheet %}
  .tooto-custom-rug-options__inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
    grid-column: 2;
    width: 100%;
    box-sizing: border-box;
  }

  {%- comment -%} HEADING {%- endcomment -%}
  .tooto-custom-rug-options__heading {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--color-foreground);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  {%- comment -%} GRID {%- endcomment -%}
  .tooto-custom-rug-options__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  {%- comment -%} CARD {%- endcomment -%}
  .tooto-custom-rug-options__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  {%- comment -%} IMAGE {%- endcomment -%}
  .tooto-custom-rug-options__image-wrapper {
    width: 100%;
    overflow: hidden;
    border-radius: 16px;
    aspect-ratio: 16 / 9;
  }

  .tooto-custom-rug-options__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tooto-custom-rug-options__image--placeholder {
    background-color: var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  {%- comment -%} ICON {%- endcomment -%}
  .tooto-custom-rug-options__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--color-foreground);
  }

  .tooto-custom-rug-options__icon-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  {%- comment -%} CARD TITLE {%- endcomment -%}
  .tooto-custom-rug-options__card-title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-foreground);
    line-height: 1.4;
  }

  {%- comment -%} CARD DESCRIPTION {%- endcomment -%}
  .tooto-custom-rug-options__card-description {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-foreground);
    opacity: 0.7;
  }

  {%- comment -%} BUTTON {%- endcomment -%}
  .tooto-custom-rug-options__button {
    display: inline-block;
    padding: 12px 24px;
    text-align: center;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    border: 1px solid var(--color-foreground);
    border-radius: 0;
    transition: all 0.2s ease;
    font-family: var(--font-body--family, inherit);
  }

  .tooto-custom-rug-options__button--filled {
    background-color: var(--color-foreground);
    color: var(--color-background);
    border-color: var(--color-foreground);
  }

  .tooto-custom-rug-options__button--filled:hover {
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .tooto-custom-rug-options__button--outline {
    background-color: transparent;
    color: var(--color-foreground);
    border-color: var(--color-foreground);
  }

  .tooto-custom-rug-options__button--outline:hover {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  {%- comment -%} RESPONSIVE {%- endcomment -%}
  @media screen and (max-width: 989px) {
    .tooto-custom-rug-options__inner {
      gap: 40px;
    }

    .tooto-custom-rug-options__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media screen and (max-width: 749px) {
    .tooto-custom-rug-options__inner {
      gap: 32px;
    }

    .tooto-custom-rug-options__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .tooto-custom-rug-options__heading {
      font-size: clamp(1.5rem, 5vw, 2rem);
    }

    .tooto-custom-rug-options__image-wrapper {
      aspect-ratio: 16 / 10;
    }

    .tooto-custom-rug-options__card-title {
      font-size: 1rem;
    }

    .tooto-custom-rug-options__card-description {
      font-size: 0.8125rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tooto Custom Rug Options",
  "tag": "section",
  "class": "tooto-custom-rug-options-wrapper",
  "blocks": [
    {
      "type": "option",
      "name": "Option",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon (overrides built-in icon)"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Built-in Icon (fallback)",
          "options": [
            { "value": "measure", "label": "Made To Measure" },
            { "value": "wall",    "label": "Wall To Wall" },
            { "value": "special", "label": "Special Request" }
          ],
          "default": "measure"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Option Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Add your option description here."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Customize Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button Style",
          "options": [
            { "value": "filled", "label": "Filled (Dark)" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "filled"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Custom Rug Options"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Tooto Custom Rug Options",
      "settings": {
        "heading": "Custom Rug Options",
        "color_scheme": "scheme-1",
        "padding-block-start": 48,
        "padding-block-end": 48
      },
      "blocks": [
        {
          "type": "option",
          "settings": {
            "icon": "measure",
            "title": "Made To Measure",
            "description": "Custom rugs precisely made to fit your space dimensions for home and commercial use.",
            "button_label": "Customize Now",
            "button_style": "filled"
          }
        },
        {
          "type": "option",
          "settings": {
            "icon": "wall",
            "title": "Wall To Wall",
            "description": "Full-room carpet customization that delivers a seamless and harmonious new look.",
            "button_label": "Customize Now",
            "button_style": "filled"
          }
        },
        {
          "type": "option",
          "settings": {
            "icon": "special",
            "title": "Special Request",
            "description": "For unique designs or special customization needs, please feel free to contact our team.",
            "button_label": "Contact Us",
            "button_style": "outline"
          }
        }
      ]
    }
  ]
}
{% endschema %}