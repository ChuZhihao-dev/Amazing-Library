

{%- liquid
  assign img_widths = '400, 600, 900'
  assign img_sizes = '(min-width: 990px) 38vw, (min-width: 750px) 45vw, 100vw'
  assign current_tag = current_tags | first | default: ''
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  id="main-blog-{{ section.id }}"
  class="section section--page-width color-{{ section.settings.color_scheme }} stories-layout"
  style="padding-block-start: {{ section.settings.padding-block-start }}px; padding-block-end: {{ section.settings.padding-block-end }}px;"
>
  <div class="stories-layout__inner">

    {%- comment -%} 顶部：标题独占一行 {%- endcomment -%}
    <div class="stories-layout__header">
      <h1 class="stories-layout__heading">{{ blog.title }}</h1>
    </div>

    {%- comment -%} 左侧：分类导航 {%- endcomment -%}
    <aside class="stories-layout__sidebar">
      <nav class="stories-layout__tags" aria-label="Blog categories">
        <ul class="stories-layout__tag-list">
          <li class="stories-layout__tag-item">
            <a
              href="{{ blog.url }}"
              class="stories-layout__tag-link{% if current_tag == blank %} stories-layout__tag-link--active{% endif %}"
            >All</a>
          </li>
          {%- for tag in blog.all_tags -%}
            <li class="stories-layout__tag-item">
              <a
                href="{{ blog.url }}/tagged/{{ tag | handleize }}"
                class="stories-layout__tag-link{% if current_tag == tag %} stories-layout__tag-link--active{% endif %}"
              >{{ tag }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    </aside>

    {%- comment -%} 右侧：文章网格 {%- endcomment -%}
    <div class="stories-layout__grid">
      {%- paginate blog.articles by section.settings.posts_per_page -%}
        {%- if blog.articles.size > 0 -%}
          {%- for article in blog.articles -%}
            <article class="stories-layout__card">
              <a href="{{ article.url }}" class="stories-layout__card-link" aria-label="{{ article.title | escape }}">
                <div class="stories-layout__card-image-wrapper">
                  {%- if article.image != blank -%}
                    {{- article.image | image_url: width: 900 | image_tag: widths: img_widths, sizes: img_sizes, alt: article.image.alt, loading: 'lazy', class: 'stories-layout__card-image' -}}
                  {%- else -%}
                    {{ 'hero-apparel-1' | placeholder_svg_tag: 'stories-layout__card-image stories-layout__card-image--placeholder' }}
                  {%- endif -%}
                </div>
                <div class="stories-layout__card-body">
                  <time class="stories-layout__card-date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                    {{ article.published_at | date: '%d.%m.%y' }}
                  </time>
                  <div class="stories-layout__card-footer">
                    <h2 class="stories-layout__card-title">{{ article.title | escape }}</h2>
                    <span class="stories-layout__card-arrow" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                      </svg>
                    </span>
                  </div>
                </div>
              </a>
            </article>
          {%- endfor -%}
        {%- else -%}
          <p class="stories-layout__empty">No articles found.</p>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <div class="stories-layout__pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="stories-layout__page-btn">← Previous</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="stories-layout__page-btn">{{ part.title }}</a>
              {%- else -%}
                <span class="stories-layout__page-btn stories-layout__page-btn--current">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="stories-layout__page-btn">Next →</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>

  </div>
</div>

{% stylesheet %}
  .stories-layout__inner {
    display: grid;
    grid-template-columns: 180px 1fr;
    grid-template-rows: auto 1fr;
    gap: 0 48px;
    align-items: start;
    width: 100%;
    box-sizing: border-box;
  }

  /* 标题独占整行 */
  .stories-layout__header {
    grid-column: 1 / -1;
    padding-bottom: 40px;
  }

  .stories-layout__heading {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-foreground-heading);
    margin: 0;
  }

  /* ── 左侧侧边栏 ── */
  .stories-layout__sidebar {
    position: sticky;
    top: calc(var(--header-height, 80px) + 24px);
  }

  .stories-layout__tag-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .stories-layout__tag-link {
    font-size: 0.9375rem;
    color: var(--color-foreground);
    text-decoration: none;
    line-height: 1.5;
    opacity: 0.5;
    transition: opacity 0.2s ease;
    display: block;
  }

  .stories-layout__tag-link:hover {
    opacity: 1;
  }

  .stories-layout__tag-link--active {
    font-weight: 700;
    opacity: 1;
    color: var(--color-foreground-heading);
  }

  /* ── 右侧文章网格（瀑布流）── */
  .stories-layout__grid {
    columns: 2;
    column-gap: 24px;
  }

  .stories-layout__card {
    break-inside: avoid;
    margin-bottom: 40px;
  }

  .stories-layout__card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .stories-layout__card-image-wrapper {
    overflow: hidden;
    width: 100%;
  }

  .stories-layout__card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .stories-layout__card:hover .stories-layout__card-image {
    transform: scale(1.03);
  }

  .stories-layout__card-image--placeholder {
    width: 100%;
    height: 100%;
  }

  .stories-layout__card-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stories-layout__card-date {
    font-size: 0.75rem;
    color: var(--color-foreground);
    opacity: 0.6;
    display: block;
  }

  .stories-layout__card-footer {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .stories-layout__card-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-foreground-heading);
    margin: 0;
  }

  .stories-layout__card-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1.5px solid var(--color-foreground);
    color: var(--color-foreground);
    margin-top: 2px;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .stories-layout__card-link:hover .stories-layout__card-arrow {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  .stories-layout__empty {
    grid-column: 1 / -1;
    color: var(--color-foreground);
    opacity: 0.6;
    font-size: 0.9375rem;
  }

  /* ── 分页 ── */
  .stories-layout__pagination {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 24px;
  }

  .stories-layout__page-btn {
    padding: 8px 16px;
    border: 1px solid var(--color-foreground);
    border-radius: 4px;
    text-decoration: none;
    color: var(--color-foreground);
    font-size: 0.875rem;
    transition: background-color 0.2s ease;
  }

  .stories-layout__page-btn--current {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  /* ── 响应式 ── */
  @media (max-width: 749px) {
    .stories-layout__inner {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .stories-layout__header {
      padding-bottom: 24px;
    }

    .stories-layout__sidebar {
      position: static;
      padding-bottom: 24px;
    }

    .stories-layout__tag-list {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 8px 16px;
    }

    .stories-layout__grid {
      columns: 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_posts",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "Posts per page",
      "min": 2,
      "max": 24,
      "step": 2,
      "default": 12
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ]
}
{% endschema %}
