  "class": "tooto-footer-main-wrapper",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "woo carpet"
    },
    {
      "type": "text",
      "id": "slogan",
      "label": "Slogan",
      "default": "Weave Inspiration, Unroll Your Story"
    },
    {
      "type": "header",
      "content": "Subscribe"
    },
    {
      "type": "text",
      "id": "subscribe_placeholder",
      "label": "Input Placeholder",
      "default": "Email Address"
    },
    {
      "type": "text",
      "id": "subscribe_label",
      "label": "Button Label",
      "default": "SUBSCRIBE"
    },
    {
      "type": "header",
      "content": "Contact Info"
    },
    {
      "type": "text",
      "id": "contact_email_label",
      "label": "Email Label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email Address",
      "default": "info@woocarpet.com"
    },
    {
      "type": "text",
      "id": "contact_tel_label",
      "label": "Tel Label",
      "default": "Tel"
    },
    {
      "type": "text",
      "id": "contact_tel",
      "label": "Phone Number",
      "default": "+86 18355248224"
    },
    {
      "type": "text",
      "id": "contact_address_label",
      "label": "Address Label",
      "default": "Address"
    },
    {
      "type": "textarea",
      "id": "contact_address",
      "label": "Address",
      "default": "2407 Chico Ave, Unit A, Building 9, CCC 91733"
    },

    {
      "type": "header",
      "content": "Bottom Bar"
    },
    {
