{%- liquid
  assign logo_image = section.settings.logo
  assign brand_name = section.settings.brand_name
  assign slogan = section.settings.slogan
  assign email_label = section.settings.contact_email_label
  assign email_value = section.settings.contact_email
  assign tel_label = section.settings.contact_tel_label
  assign tel_value = section.settings.contact_tel
  assign address_label = section.settings.contact_address_label
  assign address_value = section.settings.contact_address
  assign copyright_text = section.settings.copyright_text
  assign section_width = section.settings.section_width | default: 'page-width'
  assign subscribe_form_id = 'tooto-footer-subscribe-form-' | append: section.id
  assign subscribe_input_id = 'tooto-footer-subscribe-email-' | append: section.id
  assign subscribe_return_to = request.path | append: '#' | append: subscribe_form_id
-%}

<div class="tooto-footer-main section section--{{ section_width }} color-{{ section.settings.color_scheme }}">
  <div class="tooto-footer-main__inner">

  {%- comment -%} ===== TOP SECTION: Logo + Contact + Subscribe ===== {%- endcomment -%}
  <div class="tooto-footer-main__top">
    <div class="tooto-footer-main__top-inner">

      {%- comment -%} Left: Logo / Brand / Slogan {%- endcomment -%}
      <div class="tooto-footer-main__brand">
        {%- if logo_image != blank -%}
          {{
            logo_image
            | image_url: width: 200
            | image_tag:
              loading: 'lazy',
              class: 'tooto-footer-main__logo-img',
              alt: logo_image.alt | default: brand_name
          }}
        {%- endif -%}
        {%- if brand_name != blank -%}
          <p class="tooto-footer-main__brand-name">{{ brand_name }}</p>
        {%- endif -%}
        {%- if slogan != blank -%}
          <p class="tooto-footer-main__slogan">{{ slogan }}</p>
        {%- endif -%}
      </div>

      {%- comment -%} Right: Subscribe + Contact Info {%- endcomment -%}
      <div class="tooto-footer-main__right">

        {%- comment -%} Email Subscribe Form {%- endcomment -%}
        <div class="tooto-footer-main__subscribe">
          {%- form 'customer', id: subscribe_form_id, class: 'tooto-footer-main__subscribe-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input type="hidden" name="contact[id]" value="{{ subscribe_form_id }}">
            <input type="hidden" name="return_to" value="{{ subscribe_return_to }}">
            <div class="tooto-footer-main__subscribe-row{% if form.errors and form.id == subscribe_form_id %} is-error{% endif %}">
              <label class="visually-hidden" for="{{ subscribe_input_id }}">
                {{ section.settings.subscribe_placeholder | default: 'Email Address' }}
              </label>
              <input
                id="{{ subscribe_input_id }}"
                type="email"
                name="contact[email]"
                class="tooto-footer-main__subscribe-input"
                placeholder="{{ section.settings.subscribe_placeholder | default: 'Email Address' }}"
                aria-label="{{ section.settings.subscribe_placeholder | default: 'Email Address' }}"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                {% if form.errors and form.id == subscribe_form_id %}
                  aria-invalid="true"
                  aria-describedby="{{ subscribe_form_id }}-error"
                {% elsif form.posted_successfully? and form.id == subscribe_form_id %}
                  aria-describedby="{{ subscribe_form_id }}-success"
                {% endif %}
                required
              >
              <button type="submit" class="tooto-footer-main__subscribe-btn">
                {{ section.settings.subscribe_label | default: 'SUBSCRIBE' }}
              </button>
            </div>

            {%- if form.errors and form.id == subscribe_form_id -%}
              <div
                id="{{ subscribe_form_id }}-error"
                class="tooto-footer-main__subscribe-feedback tooto-footer-main__subscribe-feedback--error"
                data-subscribe-feedback
                tabindex="-1"
                role="alert"
              >
                {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
              </div>
            {%- elsif form.posted_successfully? and form.id == subscribe_form_id -%}
              <div
                id="{{ subscribe_form_id }}-success"
                class="tooto-footer-main__subscribe-feedback tooto-footer-main__subscribe-feedback--success"
                data-subscribe-feedback
                tabindex="-1"
                role="status"
              >
                {{- 'blocks.email_signup.success' | t -}}
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>

        {%- comment -%} Contact Info {%- endcomment -%}
        <div class="tooto-footer-main__contact">
          {%- if email_value != blank -%}
            <p class="tooto-footer-main__contact-item">
              <span class="tooto-footer-main__contact-label">{{ email_label | default: 'Email' }}:</span>
              <a href="mailto:{{ email_value }}" class="tooto-footer-main__contact-value">{{ email_value }}</a>
            </p>
          {%- endif -%}
          {%- if tel_value != blank -%}
            <p class="tooto-footer-main__contact-item">
              <span class="tooto-footer-main__contact-label">{{ tel_label | default: 'Tel' }}:</span>
              <a href="tel:{{ tel_value | remove: ' ' }}" class="tooto-footer-main__contact-value">{{ tel_value }}</a>
            </p>
          {%- endif -%}
          {%- if address_value != blank -%}
            <p class="tooto-footer-main__contact-item">
              <span class="tooto-footer-main__contact-label">{{ address_label | default: 'Address' }}:</span>
              <span class="tooto-footer-main__contact-value">{{ address_value }}</span>
            </p>
          {%- endif -%}
        </div>

      </div>
    </div>
  </div>

  {%- comment -%} ===== DIVIDER ===== {%- endcomment -%}
  <div class="tooto-footer-main__divider">
    <hr class="tooto-footer-main__hr">
  </div>

  {%- comment -%} ===== MIDDLE SECTION: Nav Menus (Blocks) ===== {%- endcomment -%}
  <div class="tooto-footer-main__nav">
    {%- for block in section.blocks -%}
      {%- if block.type == 'menu' -%}
        {%- assign nav_menu = linklists[block.settings.menu] -%}
        {%- if nav_menu != blank and nav_menu.links.size > 0 -%}
          <div class="tooto-footer-main__nav-col">
            <p class="tooto-footer-main__nav-title">
              {%- if block.settings.menu_title != blank -%}
                {{ block.settings.menu_title }}
              {%- else -%}
                {{ nav_menu.title }}
              {%- endif -%}
            </p>
            <ul class="tooto-footer-main__nav-list">
              {%- for link in nav_menu.links -%}
                <li class="tooto-footer-main__nav-item">
                  <a href="{{ link.url }}" class="tooto-footer-main__nav-link">{{ link.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- comment -%} ===== BOTTOM SECTION: Copyright + Social ===== {%- endcomment -%}
  <div class="tooto-footer-main__bottom">

    {%- comment -%} Copyright {%- endcomment -%}
    <p class="tooto-footer-main__copyright">
      {%- if copyright_text != blank -%}
        {{ copyright_text }}
      {%- else -%}
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'general.footer.copyright' | t }}
      {%- endif -%}
    </p>

    {%- comment -%} Social Icons {%- endcomment -%}
    <div class="tooto-footer-main__social">
      {%- if section.settings.facebook_url != blank -%}
        <a href="{{ section.settings.facebook_url }}" class="tooto-footer-main__social-link" target="_blank" rel="noopener" aria-label="Facebook">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        </a>
      {%- endif -%}
      {%- if section.settings.twitter_url != blank -%}
        <a href="{{ section.settings.twitter_url }}" class="tooto-footer-main__social-link" target="_blank" rel="noopener" aria-label="X / Twitter">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
      {%- endif -%}
      {%- if section.settings.instagram_url != blank -%}
        <a href="{{ section.settings.instagram_url }}" class="tooto-footer-main__social-link" target="_blank" rel="noopener" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </a>
      {%- endif -%}
      {%- if section.settings.linkedin_url != blank -%}
        <a href="{{ section.settings.linkedin_url }}" class="tooto-footer-main__social-link" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
        </a>
      {%- endif -%}
      {%- if section.settings.youtube_url != blank -%}
        <a href="{{ section.settings.youtube_url }}" class="tooto-footer-main__social-link" target="_blank" rel="noopener" aria-label="YouTube">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.95C5.12 20 12 20 12 20s6.88 0 8.59-.47a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/>
            <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="white"/>
          </svg>
        </a>
      {%- endif -%}
      {%- if section.settings.pinterest_url != blank -%}
        <a href="{{ section.settings.pinterest_url }}" class="tooto-footer-main__social-link" target="_blank" rel="noopener" aria-label="Pinterest">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/>
          </svg>
        </a>
      {%- endif -%}
    </div>

  </div>

  </div>
</div>

<script>
  (function () {
    const formEl = document.getElementById('{{ subscribe_form_id }}');
    if (!formEl) return;
    if (window.location.hash !== '#{{ subscribe_form_id }}') return;

    const feedbackEl = formEl.querySelector('[data-subscribe-feedback]');
    if (!(feedbackEl instanceof HTMLElement)) return;

    requestAnimationFrame(function () {
      try {
        feedbackEl.focus();
      } catch (error) {
        console.warn('Footer subscribe feedback focus failed', error);
      }
    });
  })();
</script>

{% stylesheet %}
  /* ===== WRAPPER ===== */
  .tooto-footer-main {
    width: 100%;
  }

  .tooto-footer-main__inner {
    grid-column: 1 / -1;
  }

  .section--page-width .tooto-footer-main__inner {
    grid-column: 2;
  }

  .tooto-footer-main__top {
    padding-block: 100px 55px;
  }

  .tooto-footer-main__top-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .tooto-footer-main__brand {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex-shrink: 0;
  }

  .tooto-footer-main__logo-img {
    width: 184px;
    object-fit: contain;
    display: block;
  }

  .tooto-footer-main__brand-name {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-foreground);
    letter-spacing: 0.02em;
  }

  .tooto-footer-main__slogan {
    margin: 0;
    font-size: 20px;
    color: var(--color-foreground);
    opacity: 0.6;
  }

  .tooto-footer-main__right {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  .tooto-footer-main__subscribe-form {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .tooto-footer-main__subscribe-row {
    display: flex;
    align-items: stretch;
    border: 1px solid rgba(209,209,209,0.6);
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .tooto-footer-main__subscribe-row:focus-within {
    border-color: var(--color-foreground);
  }

  .tooto-footer-main__subscribe-row.is-error {
    border-color: var(--color-foreground);
  }

  .tooto-footer-main__subscribe-input {
    flex: 1;
    min-width: 0;
    padding: 14px 20px;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-foreground);
    font-size: 14px;
    line-height: 20px;
  }

  .tooto-footer-main__subscribe-input::placeholder {
    color: var(--color-foreground);
  }

  .tooto-footer-main__subscribe-feedback {
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-foreground);
    opacity: 0.78;
  }

  .tooto-footer-main__subscribe-feedback--success {
    opacity: 1;
  }

  .tooto-footer-main__subscribe-feedback--error {
    opacity: 1;
  }

  .tooto-footer-main__subscribe-btn {
    padding: 12px 20px;
    background: var(--color-foreground);
    color: var(--color-background);
    border: none;
    cursor: pointer;
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
    text-transform: uppercase;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .tooto-footer-main__subscribe-btn:hover {
    opacity: 0.85;
  }

  .tooto-footer-main__contact {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .tooto-footer-main__contact-item {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-foreground);
    display: flex;
    gap: 6px;
    align-items: baseline;
    flex-wrap: wrap;
  }

  .tooto-footer-main__contact-label {
    font-weight: 500;
    white-space: nowrap;
    opacity: 0.85;
  }

  .tooto-footer-main__contact-value {
    color: var(--color-foreground);
    text-decoration: none;
  }
  .tooto-footer-main__contact-value:active {
    color: #fff !important;
    text-decoration: underline;
    text-decoration-color: #fff !important;
  }
  .tooto-footer-main__contact-value:hover {
    opacity: 1;
    text-decoration: underline;
    color: white !important;
    text-decoration: underline;
    text-decoration-color: #fff !important;
  }

  /* ===== DIVIDER ===== */
  .tooto-footer-main__divider {
    /* padding-inline: var(--page-width-padding, 20px); */
  }

  .tooto-footer-main__hr {
    margin: 0;
    border: none;
    border-top: 1px solid var(--color-foreground);
    opacity: 0.2;
  }

  /* ===== NAV MENUS ===== */
  .tooto-footer-main__nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 24px;
    padding-block: 40px;
  }

  .tooto-footer-main__nav-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tooto-footer-main__nav-title {
    margin: 0;
    font-size: 20px;
    line-height: 28px;
    font-weight: 700;
    color: var(--color-foreground);
    letter-spacing: 0.01em;
  }

  .tooto-footer-main__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tooto-footer-main__nav-item {
    margin: 0;
  }

  .tooto-footer-main__nav-link {
    font-size: 0.875rem;
    color: var(--color-foreground);
    text-decoration: none;
    transition: opacity 0.2s ease;
    display: inline-block;
    position: relative;
  }

  .tooto-footer-main__nav-link::after {
    content: '';
    display: block;
    width: 0;
    height: 1px;
    background-color: var(--color-foreground);
    transition: width 0.3s ease;
  }
  .tooto-footer-main__nav-link:hover::after {
    width: 100%;
  }

  /* ===== BOTTOM ===== */
  .tooto-footer-main__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 20px 32px;
  }

  .tooto-footer-main__copyright {
    margin: 0;
    font-size: 16px;
    color: var(--color-foreground);
    font-weight: 300;
  }

  /* ===== SOCIAL ICONS ===== */
  .tooto-footer-main__social {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .tooto-footer-main__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-foreground);
    transition: opacity 0.2s ease;
    text-decoration: none;
    padding: 8px;
    border-radius: 50%;
    border: 0.8px solid rgba(255, 255, 255, 0.19);
  }

  .tooto-footer-main__social-link:hover {
    opacity: 0.8;
  }

  .tooto-footer-main__social-link svg {
    width: 16px;
    height: 16px;
  }

  /* ===== TABLET ===== */
  @media screen and (max-width: 989px) {
    .tooto-footer-main__nav {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ===== MOBILE ===== */
  @media screen and (max-width: 749px) {
    .tooto-footer-main__top {
      padding-block: 48px 32px;
    }
    .tooto-footer-main__logo-img {
      width: 124px;
    }
    .tooto-footer-main__top-inner {
      flex-direction: column;
      gap: 32px;
      align-items: start;
    }
    .tooto-footer-main__brand {
      gap: 24px;
    }
    .tooto-footer-main__right {
      width: 100%;
    }

    .tooto-footer-main__nav {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 40px;
    }

    .tooto-footer-main__bottom {
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }
    .tooto-footer-main__contact-item {
      font-size: 13px;
      font-weight: 400;
      display: block;
    }
    .tooto-footer-main__social {
      gap: 20px;
    }

    .tooto-footer-main__slogan {
      font-size: 14px;
      line-height: 1.6
    }
    .tooto-footer-main__subscribe-input {
      padding: 13px 12px;
      font-size: 12px;
    }
    .tooto-footer-main__subscribe-btn {
      font-size: 13px;
    }
    .tooto-footer-main__copyright {
      text-align: center;
      font-size: 14px;
      line-height: 1;
    }
  }
{% endstylesheet %}

{% schema %}
