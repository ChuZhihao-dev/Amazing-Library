            {%- when 'phone' -%}
              <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" fill="none" version="1.1" width="64" height="64" viewBox="0 0 64 64"><defs><clipPath id="master_svg0_7_2756"><rect x="0" y="0" width="64" height="64" rx="0"/></clipPath></defs><g clip-path="url(#master_svg0_7_2756)"><rect x="0" y="0" width="64" height="64" rx="0" fill="#FFFFFF" fill-opacity="0"/><path d="M56.852497,44.874996C56.566589,43.444614,55.928596,42.108067,54.996246,40.986248L45.966248,30.14875C44.305779,28.15004,41.84095,26.995298,39.242496,26.998751L23.769997,26.998751C21.171247,26.998751,18.707498,28.150003,17.046247,30.14875L8.0162487,40.986248C7.082552,42.107685,6.4432633,43.444263,6.1562488,44.874996L4.92624897,51.021248C4.30576637,54.116547,6.6743722000000005,57.004868,9.8312483,57.002499L53.181248,57.002499C56.334995,57.002499,58.701244,54.114998,58.082497,51.021248L56.856247,44.87125L56.852497,44.874996ZM31.502497,44.499996C25.982496,44.499996,21.504999,41.702499,21.504999,38.252499C21.504999,34.802499999999995,25.982496,32.001247,31.506247,32.001247C37.029995,32.001247,41.503746,34.798746,41.503746,38.252499C41.503746,41.702496,37.029995,44.499996,31.506247,44.499996L31.502497,44.499996ZM59.008747,20.751248L59.008747,23.874998C59.008747,25.599998,57.609997,26.998747,55.884995,27.002501L44.634998,27.002501C42.907726,27.002501,41.507492,25.602268,41.507492,23.874998L41.507492,20.751248C41.507492,19.974998,40.532494,19.056248,38.957493,18.358749C36.984997,17.481248,34.341248,17.001248,31.502497,17.001248C28.663746,17.001248,26.023748,17.481248,24.054998,18.358749C22.479998,19.05625,21.504999,19.971249,21.504999,20.751248L21.504999,23.874998C21.501249,25.599998,20.102499,26.998747,18.377499,27.002501L7.1274998,27.002501C5.4002295,27.002501,4.00000028610228,25.602268,4,23.874998L4,20.751248C4,16.9037485,6.9849996999999995,13.363749,12.3999996,10.7837496C17.526249999999997,8.3462497,24.30625,7,31.502497,7C38.694996,7,45.478748,8.3425001,50.60125,10.7837496C56.016251,13.363749,59.001251,16.9037495,59.001251,20.751248L59.008747,20.751248Z" fill="#000000" fill-opacity="1" style="mix-blend-mode:passthrough"/></g></svg>
            {%- when 'email' -%}
              <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" fill="none" version="1.1" width="64" height="64" viewBox="0 0 64 64"><defs><clipPath id="master_svg0_7_2760"><rect x="0" y="0" width="64" height="64" rx="0"/></clipPath></defs><g clip-path="url(#master_svg0_7_2760)"><rect x="0" y="0" width="64" height="64" rx="0" fill="#FFFFFF" fill-opacity="0"/><path d="M6.364974,7L57.277409,7C60.750553,7,63.598232,9.7740986,63.642384,13.173656900000001L31.83223,30.635025L0.029433407,13.1957321C0.058866814,9.7814569,2.8844738,7,6.364974,7ZM0.029433407,19.877115L0,50.752758C0,54.18911,2.8623989,57,6.364974,57L57.277409,57C60.779984,57,63.642384,54.18911,63.642384,50.752758L63.642384,19.862399L32.582783,36.50699C32.104488,36.764532,31.530537,36.764532,31.059603,36.50699L0.029433407,19.877115Z" fill="#000000" fill-opacity="1" style="mix-blend-mode:passthrough"/></g></svg>
          {%- endcase -%}
        </div>

        {%- comment -%} Title {%- endcomment -%}
        {%- if block.settings.title != blank -%}
          <h3 class="tooto-contact-info__title">{{ block.settings.title | escape }}</h3>
        {%- endif -%}

        {%- comment -%} Description {%- endcomment -%}
        {%- if block.settings.description != blank -%}
          <div class="tooto-contact-info__description">{{ block.settings.description }}</div>
        {%- endif -%}

        {%- comment -%} Button {%- endcomment -%}
        {%- if block.settings.button_label != blank -%}
          <a
            href="{{ block.settings.button_url }}"
            class="tooto-contact-info__button"
          >
            {{ block.settings.button_label | escape }}
          </a>
        {%- endif -%}

      </div>
      {%- unless forloop.last -%}<div class="tooto-contact-info__divider"></div>{%- endunless -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .tooto-contact-info {
    width: 100%;
  }

  .tooto-contact-info__grid {
    display: flex;
    gap: 0;
    justify-content: space-between;
  }

  @media (max-width: 749px) {
    .tooto-contact-info__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }

  .tooto-contact-info__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 8px 0px;
    gap: 8px;
  }

  .tooto-contact-info__divider {
    width: 1px;
    background-color: #d0d0d0;
    align-self: stretch;
  }

  @media (max-width: 749px) {
    .tooto-contact-info__divider {
      width: 100%;
      height: 1px;
    }
  }

  .tooto-contact-info__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1a1a1a;
    margin-bottom: 4px;
  }

  .tooto-contact-info__title {
    font-size: 24px;
    font-weight: 500;
    color: #393939;
    margin: 0;
  }

  .tooto-contact-info__description {
    font-size: 14px;
    color: #393939;
    margin: 0;
    max-width: 228px;
  }

  .tooto-contact-info__button {
    display: inline-block;
    margin-top: 10px;
    padding: 8px;
    border: 1px solid #29375b33;
    font-size: 16px;
    font-weight: 600;
    color: #000000;
    text-decoration: none;
    background-color: transparent;
    transition: background-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
    min-width: 228px;
  }

  .tooto-contact-info__button:hover {
    background-color: #1a1a1a;
    color: #ffffff;
  }
  @media(max-width: 768px) {
    .tooto-contact-info__icon {
      width: 32px;
      height: 32px;
    }
    .tooto-contact-info__title {
      font-size: 16px;
    }
    .tooto-contact-info__description {
      font-size: 12px;
    }
    .tooto-contact-info__button {
      font-size: 12px;
      min-width: 164px;
    }
    .tooto-contact-info {
      padding-block: 48px !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tooto Contact Info",
  "tag": "section",
  "class": "tooto-contact-info-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "contact_item",
      "name": "Contact Item",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "chat",  "label": "Live Chat" },
            { "value": "phone", "label": "Phone" },
            { "value": "email", "label": "Email" }
          ],
          "default": "chat"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Live Chat"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Our support team is online and ready to assist—just click the chat bubble to get started.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Start Chat"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tooto Contact Info",
      "settings": {
        "section_width": "page-width",
        "color_scheme": "scheme-3",
        "padding-block-start": 64,
        "padding-block-end": 64
      },
      "blocks": [
        {
          "type": "contact_item",
          "settings": {
            "icon": "chat",
            "title": "Live Chat",
            "description": "<p>Our support team is online and ready to assist—just click the chat bubble to get started.</p>",
            "button_label": "Start Chat",
            "button_url": ""
          }
        },
        {
          "type": "contact_item",
          "settings": {
            "icon": "phone",
            "title": "Call us",
            "description": "<p>Prefer to talk? We'd love to hear from you. Available 9am–6pm PDT (Mon–Sun)</p>",
            "button_label": "+86 18355248224",
            "button_url": "tel:+18355248224"
          }
        },
        {
          "type": "contact_item",
          "settings": {
            "icon": "email",
            "title": "Email us",
            "description": "<p>We respond to all inquiries within 24 hours.<br>service@woocarpet.com</p>",
            "button_label": "Send an Email",
            "button_url": "mailto:service@woocarpet.com"
          }
        }
      ]
    }
  ]
}
{% endschema %}