<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  id="tooto-contact-info-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} tooto-contact-info"
  style="padding-block-start: {{ section.settings.padding-block-start }}px; padding-block-end: {{ section.settings.padding-block-end }}px;"
>
  <div class="tooto-contact-info__grid">
    {%- for block in section.blocks -%}
      <div class="tooto-contact-info__item" {{ block.shopify_attributes }}>

