{%- liquid
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign hero_image = section.settings.hero_image
  assign hero_image_mobile = section.settings.hero_image_mobile
-%}

{%- if hero_image_mobile != blank -%}
  <style>
    /* 桌面端：隐藏 mobile 图 */
    #shopify-section-{{ section.id }} .tooto-custom-size-hero__image--mobile { display: none !important; }
    /* 移动端：隐藏 desktop 图，显示 mobile 图 */
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .tooto-custom-size-hero__image--desktop { display: none !important; }
      #shopify-section-{{ section.id }} .tooto-custom-size-hero__image--mobile { display: block !important; }
    }
  </style>
{%- endif -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--page-width color-{{ section.settings.color_scheme }}"
  style="padding-block-start: {{ section.settings.padding-block-start }}px; padding-block-end: {{ section.settings.padding-block-end }}px;"
>
  <div class="tooto-custom-size-hero__inner">

    <div class="tooto-custom-size-hero__top">
      <div class="tooto-custom-size-hero__left">
        {%- if heading != blank -%}
          <h1 class="tooto-custom-size-hero__heading">{{ heading }}</h1>
        {%- endif -%}
      </div>

      <div class="tooto-custom-size-hero__right">
        {%- if description != blank -%}
          <p class="tooto-custom-size-hero__description">{{ description }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="tooto-custom-size-hero__bottom">
      {%- if hero_image != blank -%}
        {%- liquid
          assign img_widths = '400, 600, 800, 1000, 1200, 1400'
          assign img_sizes = '(min-width: 1200px) calc(100vw - 40px), calc(100vw - 40px)'
          assign img_widths_mobile = '400, 600, 800, 1000'
          assign img_sizes_mobile = '100vw'
          assign img_alt = hero_image.alt | default: section.settings.heading
          assign img_alt_mobile = hero_image_mobile.alt | default: section.settings.heading
        -%}
        {{
          hero_image
          | image_url: width: 1400
          | image_tag:
            widths: img_widths,
            sizes: img_sizes,
            alt: img_alt,
            class: 'tooto-custom-size-hero__image tooto-custom-size-hero__image--desktop',
            loading: 'lazy'
        }}
        {%- if hero_image_mobile != blank -%}
          {{
            hero_image_mobile
            | image_url: width: 1000
            | image_tag:
              widths: img_widths_mobile,
              sizes: img_sizes_mobile,
              alt: img_alt_mobile,
              class: 'tooto-custom-size-hero__image tooto-custom-size-hero__image--mobile',
              loading: 'lazy'
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'tooto-custom-size-hero__image tooto-custom-size-hero__image--placeholder' }}
      {%- endif -%}
    </div>

  </div>
</div>

{% stylesheet %}
  .tooto-custom-size-hero__inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
    grid-column: 2;
    width: 100%;
    box-sizing: border-box;
  }

  .tooto-custom-size-hero__top {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 54px;
    align-items: center;
  }

  .tooto-custom-size-hero__left {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .tooto-custom-size-hero__heading {
    margin: 0;
    font-size: 88px;
    font-weight: 700;
    color: var(--color-foreground);
    line-height: 1;
  }

  .tooto-custom-size-hero__right {
    display: flex;
    flex-direction: column;
    gap: 16px;
    justify-content: flex-start;
  }

  .tooto-custom-size-hero__description {
    margin-left: auto;
    font-size: 1rem;
    font-weight: 400;
    line-height: 24px;
    color: var(--color-foreground);
    max-width: 440px;
  }
  
  .tooto-custom-size-hero__bottom {
    width: 100%;
  }

  .tooto-custom-size-hero__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .tooto-custom-size-hero__image--placeholder {
    background-color: var(--color-border);
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 749px) {
    .tooto-custom-size-hero__inner {
      gap: 32px;
    }

    .tooto-custom-size-hero__top {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .tooto-custom-size-hero__heading {
      font-size: 44px;
      line-height: 1.1;
    }

    .tooto-custom-size-hero__description {
      font-size: 13px;
      line-height: 18px;
    }
    .tooto-custom-size-hero-wrapper > .section {
      padding-block-start: 48px !important;
      padding-block-end: 48px !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tooto Custom Size Hero",
  "tag": "section",
  "class": "tooto-custom-size-hero-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Custom Size"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "With our tailored to fit wool rugs, you can personalise your rug by choosing the style, colour, size, shape & edging best suited to your home."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Hero Image (Mobile)"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Tooto Custom Size Hero",
      "settings": {
        "heading": "Custom Size",
        "description": "With our tailored to fit wool rugs, you can personalise your rug by choosing the style, colour, size, shape & edging best suited to your home.",
        "section_width": "page-width",
        "color_scheme": "scheme-1",
        "padding-block-start": 48,
        "padding-block-end": 48
      }
    }
  ]
}
{% endschema %}