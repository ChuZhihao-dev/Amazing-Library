{%- liquid
  assign img_widths = '750, 1100, 1500, 2000, 3000'
  assign img_sizes = '100vw'
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  id="tooto-brand-concept-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} tooto-brand-concept"
  style="padding-block-start: {{ section.settings.padding-block-start }}px; padding-block-end: {{ section.settings.padding-block-end }}px;"
>
  <div class="tooto-brand-concept__inner">

    {%- comment -%} 上半：两栏文字区 {%- endcomment -%}
    <div class="tooto-brand-concept__header">

      {%- comment -%} 左侧：大标题 {%- endcomment -%}
      <div class="tooto-brand-concept__heading-col">
        {%- if section.settings.heading != blank -%}
          <h2 class="tooto-brand-concept__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>

      {%- comment -%} 右侧：描述 + CTA {%- endcomment -%}
      <div class="tooto-brand-concept__content-col">
        {%- if section.settings.description != blank -%}
          <p class="tooto-brand-concept__description">{{ section.settings.description }}</p>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a
            href="{{ section.settings.link_url }}"
            class="tooto-brand-concept__link"
          >
            {{ section.settings.link_label }}
            <span class="tooto-brand-concept__link-arrow" aria-hidden="true">→</span>
          </a>
        {%- endif -%}
      </div>

    </div>

    {%- comment -%} 下半：全宽大图或视频 {%- endcomment -%}
    <div class="tooto-brand-concept__image-wrapper">
      {%- if section.settings.media_type == 'image' -%}
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 2000
            | image_tag:
              widths: img_widths,
              sizes: img_sizes,
              alt: section.settings.image.alt,
              loading: 'lazy',
              class: 'tooto-brand-concept__image'
          }}
        {%- else -%}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'tooto-brand-concept__image tooto-brand-concept__image--placeholder' }}
        {%- endif -%}
      {%- elsif section.settings.media_type == 'video' and section.settings.video != blank -%}
        <video
          class="tooto-brand-concept__video"
          width="1600"
          height="900"
          controls
          playsinline
          preload="metadata"
        >
          <source src="{{ section.settings.video.sources[0].url }}" type="{{ section.settings.video.sources[0].format }}">
          Your browser does not support the video tag.
        </video>
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'tooto-brand-concept__image tooto-brand-concept__image--placeholder' }}
      {%- endif -%}
    </div>

  </div>
</div>

{% stylesheet %}
  .tooto-brand-concept__inner {
    grid-column: 1 / -1;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .section--page-width .tooto-brand-concept__inner {
    grid-column: 2;
  }

  /* ── 上半两栏 ── */
  .tooto-brand-concept__header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }

  @media (max-width: 749px) {
    .tooto-brand-concept__header {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  /* ── 标题 ── */
  .tooto-brand-concept__heading {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--color-foreground-heading);
    margin: 0;
    letter-spacing: -0.02em;
  }

  /* ── 右侧内容 ── */
  .tooto-brand-concept__content-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 8px;
  }

  .tooto-brand-concept__description {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-foreground);
    margin: 0;
  }

  /* ── CTA 文字链接 ── */
  .tooto-brand-concept__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: opacity 0.2s ease;
  }

  .tooto-brand-concept__link:hover {
    opacity: 0.65;
  }

  .tooto-brand-concept__link-arrow {
    transition: transform 0.2s ease;
  }

  .tooto-brand-concept__link:hover .tooto-brand-concept__link-arrow {
    transform: translateX(4px);
  }

  /* ── 图片 ── */
  .tooto-brand-concept__image-wrapper {
    width: 100%;
    aspect-ratio: 16 / 7;
    overflow: hidden;
    border-radius: 4px;
  }

  .tooto-brand-concept__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tooto-brand-concept__image--placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── 视频 ── */
  .tooto-brand-concept__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background: var(--color-background);
  }

  @media (max-width: 749px) {
    .tooto-brand-concept__image-wrapper {
      aspect-ratio: 4 / 3;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tooto Brand Concept",
  "tag": "section",
  "class": "tooto-brand-concept-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Woo Brand Concept Slogn"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Made from natural animal fibers, wool carpets offer a soft, skin-friendly touch and a warm, inviting feel. Their inherent elasticity reduces foot fatigue, making them ideal for bedrooms or children's rooms."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link Label",
      "default": "See More"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media Type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Tooto Brand Concept",
      "settings": {
        "heading": "Woo Brand Concept Slogn",
        "description": "Made from natural animal fibers, wool carpets offer a soft, skin-friendly touch and a warm, inviting feel. Their inherent elasticity reduces foot fatigue, making them ideal for bedrooms or children's rooms.",
        "link_label": "See More",
        "section_width": "page-width",
        "color_scheme": "scheme-1",
        "padding-block-start": 64,
        "padding-block-end": 64
      }
    }
  ]
}
{% endschema %}