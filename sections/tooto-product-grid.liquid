{%- liquid
  assign card_img_widths = '300, 400, 600, 800'
  assign card_img_sizes = '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  id="tooto-product-grid-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} tooto-product-grid"
  style="padding-block-start: {{ section.settings.padding-block-start }}px; padding-block-end: {{ section.settings.padding-block-end }}px;"
>
  <div class="tooto-product-grid__inner">

    {%- comment -%} ── 产品卡片网格 ── {%- endcomment -%}
    <div class="tooto-product-grid__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign initial_media_index = 0
          if block.settings.swatch_image_1 != blank
            assign initial_media_index = 1
          elsif block.settings.swatch_image_2 != blank
            assign initial_media_index = 2
          elsif block.settings.swatch_image_3 != blank
            assign initial_media_index = 3
          endif
        -%}
        <div class="tooto-product-grid__card" {{ block.shopify_attributes }}>

          <div class="tooto-product-grid__image-wrapper" data-initial-media-index="{{ initial_media_index }}">
            {%- if block.settings.product_image != blank -%}
              <div class="tooto-product-grid__media{% if initial_media_index == 0 %} is-active{% endif %}" data-media-index="0" {% if initial_media_index != 0 %}hidden{% endif %}>
                {{
                  block.settings.product_image
                  | image_url: width: 800
                  | image_tag:
                    widths: card_img_widths,
                    sizes: card_img_sizes,
                    alt: block.settings.product_image.alt,
                    loading: 'lazy',
                    class: 'tooto-product-grid__image'
                }}
              </div>
            {%- endif -%}

            {%- if block.settings.swatch_image_1 != blank -%}
              <div class="tooto-product-grid__media{% if initial_media_index == 1 %} is-active{% endif %}" data-media-index="1" {% if initial_media_index != 1 %}hidden{% endif %}>
                {{
                  block.settings.swatch_image_1
                  | image_url: width: 800
                  | image_tag:
                    widths: card_img_widths,
                    sizes: card_img_sizes,
                    alt: block.settings.swatch_image_1.alt,
                    loading: 'lazy',
                    class: 'tooto-product-grid__image'
                }}
              </div>
            {%- endif -%}

            {%- if block.settings.swatch_image_2 != blank -%}
              <div class="tooto-product-grid__media{% if initial_media_index == 2 %} is-active{% endif %}" data-media-index="2" {% if initial_media_index != 2 %}hidden{% endif %}>
                {{
                  block.settings.swatch_image_2
                  | image_url: width: 800
                  | image_tag:
                    widths: card_img_widths,
                    sizes: card_img_sizes,
                    alt: block.settings.swatch_image_2.alt,
                    loading: 'lazy',
                    class: 'tooto-product-grid__image'
                }}
              </div>
            {%- endif -%}

            {%- if block.settings.swatch_image_3 != blank -%}
              <div class="tooto-product-grid__media{% if initial_media_index == 3 %} is-active{% endif %}" data-media-index="3" {% if initial_media_index != 3 %}hidden{% endif %}>
                {{
                  block.settings.swatch_image_3
                  | image_url: width: 800
                  | image_tag:
                    widths: card_img_widths,
                    sizes: card_img_sizes,
                    alt: block.settings.swatch_image_3.alt,
                    loading: 'lazy',
                    class: 'tooto-product-grid__image'
                }}
              </div>
            {%- endif -%}

            {%- if block.settings.product_image == blank and block.settings.swatch_image_1 == blank and block.settings.swatch_image_2 == blank and block.settings.swatch_image_3 == blank -%}
              {{ 'product-1' | placeholder_svg_tag: 'tooto-product-grid__image tooto-product-grid__image--placeholder' }}
            {%- endif -%}
          </div>

          <div class="tooto-product-grid__swatches">
            {%- if block.settings.swatch_color_1 != blank -%}
              <button
                type="button"
                class="tooto-product-grid__swatch{% if initial_media_index == 1 %} is-active{% endif %}"
                style="background-color: {{ block.settings.swatch_color_1 }};"
                aria-label="{{ block.settings.swatch_label_1 | escape }}"
                data-image-index="{% if block.settings.swatch_image_1 != blank %}1{% else %}{{ initial_media_index }}{% endif %}"
              ></button>
            {%- endif -%}
            {%- if block.settings.swatch_color_2 != blank -%}
              <button
                type="button"
                class="tooto-product-grid__swatch{% if initial_media_index == 2 %} is-active{% endif %}"
                style="background-color: {{ block.settings.swatch_color_2 }};"
                aria-label="{{ block.settings.swatch_label_2 | escape }}"
                data-image-index="{% if block.settings.swatch_image_2 != blank %}2{% else %}{{ initial_media_index }}{% endif %}"
              ></button>
            {%- endif -%}
            {%- if block.settings.swatch_color_3 != blank -%}
              <button
                type="button"
                class="tooto-product-grid__swatch{% if initial_media_index == 3 %} is-active{% endif %}"
                style="background-color: {{ block.settings.swatch_color_3 }};"
                aria-label="{{ block.settings.swatch_label_3 | escape }}"
                data-image-index="{% if block.settings.swatch_image_3 != blank %}3{% else %}{{ initial_media_index }}{% endif %}"
              ></button>
            {%- endif -%}
          </div>

          {%- comment -%} 产品名 + 价格 {%- endcomment -%}
          <div class="tooto-product-grid__info">
            {%- if block.settings.product_url != blank -%}
              <a class="tooto-product-grid__name-link" href="{{ block.settings.product_url }}">
                <p class="tooto-product-grid__name">{{ block.settings.product_name | escape }}</p>
              </a>
            {%- else -%}
              <p class="tooto-product-grid__name">{{ block.settings.product_name | escape }}</p>
            {%- endif -%}
            {%- if block.settings.product_price != blank -%}
              <p class="tooto-product-grid__price">{{ block.settings.product_price | escape }}</p>
            {%- endif -%}
          </div>

        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} ── SEE MORE 按钮 ── {%- endcomment -%}
    {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
      <div class="tooto-product-grid__cta-wrapper">
        <a
          class="tooto-product-grid__cta"
          href="{{ section.settings.cta_url }}"
        >
          {{ section.settings.cta_label | escape }}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

<script>
  (function () {
    const sectionEl = document.getElementById('tooto-product-grid-{{ section.id }}');
    if (!sectionEl) return;

    sectionEl.querySelectorAll('.tooto-product-grid__card').forEach(function (cardEl) {
      const mediaItems = Array.from(cardEl.querySelectorAll('.tooto-product-grid__media'));
      const swatchButtons = Array.from(cardEl.querySelectorAll('.tooto-product-grid__swatch[data-image-index]'));

      if (!mediaItems.length || !swatchButtons.length) return;

      function setActiveMedia(targetIndex) {
        mediaItems.forEach(function (mediaEl) {
          const isActive = mediaEl.dataset.mediaIndex === targetIndex;
          mediaEl.hidden = !isActive;
          mediaEl.classList.toggle('is-active', isActive);
        });

        swatchButtons.forEach(function (buttonEl) {
          buttonEl.classList.toggle('is-active', buttonEl.dataset.imageIndex === targetIndex);
        });
      }

      swatchButtons.forEach(function (buttonEl) {
        buttonEl.addEventListener('click', function () {
          const targetIndex = buttonEl.dataset.imageIndex;
          if (!targetIndex) return;
          setActiveMedia(targetIndex);
        });
      });
    });
  })();
</script>

{% stylesheet %}
  /* ── 脱离主题 section grid ── */
  .tooto-product-grid__inner {
    grid-column: 1 / -1;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
  }

  .section--page-width .tooto-product-grid__inner {
    grid-column: 2;
  }

  /* ── 卡片网格 ── */
  .tooto-product-grid__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    width: 100%;
  }

  /* ── 单张卡片 ── */
  .tooto-product-grid__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  /* ── 产品图 ── */
  .tooto-product-grid__image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    display: block;
    position: relative;
  }

  .tooto-product-grid__media {
    width: 100%;
    height: 100%;
  }

  .tooto-product-grid__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .tooto-product-grid__card:hover .tooto-product-grid__image {
    transform: scale(1.04);
  }

  .tooto-product-grid__image--placeholder {
    width: 100%;
    height: 100%;
  }

  /* ── 色板行 ── */
  .tooto-product-grid__swatches {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .tooto-product-grid__swatch {
    display: inline-block;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 1.5px solid rgba(var(--color-border-rgb), 0.3);
    flex-shrink: 0;
    padding: 0;
    cursor: pointer;
    background-clip: padding-box;
  }

  .tooto-product-grid__swatch.is-active {
    border-color: var(--color-foreground);
  }

  /* ── 产品信息 ── */
  .tooto-product-grid__info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
  }

  .tooto-product-grid__name-link {
    text-decoration: none;
    color: inherit;
  }

  .tooto-product-grid__name-link:hover .tooto-product-grid__name {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .tooto-product-grid__name {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-foreground-heading);
    letter-spacing: 0.01em;
    line-height: 1.4;
  }

  .tooto-product-grid__price {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-foreground);
    line-height: 1.4;
  }

  /* ── SEE MORE 按钮 ── */
  .tooto-product-grid__cta-wrapper {
    display: flex;
    justify-content: center;
  }

  .tooto-product-grid__cta {
    display: inline-block;
    padding: 13px 40px;
    background-color: var(--color-foreground);
    color: var(--color-background);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }

  .tooto-product-grid__cta:hover {
    opacity: 0.8;
  }

  /* ── 响应式 ── */
  @media (max-width: 989px) {
    .tooto-product-grid__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 749px) {
    .tooto-product-grid__grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 16px;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    .tooto-product-grid__grid::-webkit-scrollbar {
      display: none;
    }

    .tooto-product-grid__card {
      flex: 0 0 min(72vw, 280px);
      min-width: min(72vw, 280px);
      scroll-snap-align: start;
    }

    .tooto-product-grid__inner {
      gap: 32px;
    }
  }
{% endstylesheet %}

