{%- liquid
  assign bg_widths = '750, 1100, 1500, 2000, 3000, 3840'
  assign bg_sizes = '100vw'
  assign section_height = section.settings.section_height
  if request.design_mode == false
    if section.settings.section_height_mobile != blank
      assign section_height_mobile = section.settings.section_height_mobile
    endif
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  id="tooto-promo-banner-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} tooto-promo-banner"
  style="padding-block-start: {{ section.settings.padding-block-start }}px; padding-block-end: {{ section.settings.padding-block-end }}px;"
>
  <div
    class="tooto-promo-banner__inner"
    style="--section-height-desktop: {{ section.settings.section_height }}vh;"
    data-mobile-height="{{ section.settings.section_height_mobile }}"
  >

    {%- comment -%} ── 背景图 ── {%- endcomment -%}
    <div class="tooto-promo-banner__bg">
      {%- if section.settings.image != blank -%}
        <picture>
          {%- comment -%} 移动端背景图（如果有配置） {%- endcomment -%}
          {%- if section.settings.image_mobile != blank -%}
            <source
              media="(max-width: 767px)"
              srcset="{{ section.settings.image_mobile | image_url: width: 1000 }}"
            >
          {%- endif -%}
          {%- comment -%} 桌面端背景图 {%- endcomment -%}
          {{
            section.settings.image
            | image_url: width: 2000
            | image_tag:
              widths: bg_widths,
              sizes: bg_sizes,
              alt: section.settings.image.alt,
              loading: 'eager',
              fetchpriority: 'high',
              class: 'tooto-promo-banner__bg-image'
          }}
        </picture>
      {%- else -%}
        {{ 'hero-apparel-2' | placeholder_svg_tag: 'tooto-promo-banner__bg-image tooto-promo-banner__bg-image--placeholder' }}
      {%- endif -%}
    </div>

    {%- comment -%} ── 遮罩 ── {%- endcomment -%}
    {%- if section.settings.overlay_opacity > 0 -%}
      <div
        class="tooto-promo-banner__overlay"
        style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
      ></div>
    {%- endif -%}

    {%- comment -%} ── 内容层：居中 标题 + 描述 + CTA ── {%- endcomment -%}
    <div class="tooto-promo-banner__content">

      {%- if section.settings.heading != blank -%}
        <h2 class="tooto-promo-banner__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="tooto-promo-banner__description">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
        <a
          class="tooto-promo-banner__cta"
          href="{{ section.settings.cta_url }}"
        >
          {{ section.settings.cta_label | escape }}
        </a>
      {%- endif -%}

    </div>

  </div>
</div>

{% stylesheet %}
  /* ── 脱离主题 section grid ── */
  .tooto-promo-banner__inner {
    grid-column: 1 / -1;
    position: relative;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: var(--section-height-desktop, 55vh);
  }

  .section--page-width .tooto-promo-banner__inner {
    grid-column: 2;
  }

  /* ── 背景图 ── */
  .tooto-promo-banner__bg {
    position: absolute;
    inset: 0;
  }

  .tooto-promo-banner__bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tooto-promo-banner__bg-image--placeholder {
    width: 100%;
    height: 100%;
  }

  /* ── 遮罩 ── */
  .tooto-promo-banner__overlay {
    position: absolute;
    inset: 0;
    background-color: #000;
    pointer-events: none;
  }

  /* ── 内容层 ── */
  .tooto-promo-banner__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 100px 24px 40px;
    max-width: 640px;
    width: 100%;
  }

  /* ── 标题 ── */
  .tooto-promo-banner__heading {
    margin: 0;
    font-size: 56px;
    font-weight: 800;
    line-height: 64px;
    color: var(--color-background);
  }

  /* ── 描述 ── */
  .tooto-promo-banner__description {
    margin: 0;
    font-size: 1;
    line-height: 24px;
    margin-bottom: 32px;
    color: var(--color-background);
  }

  /* ── CTA 按钮：白底黑字 ── */
  .tooto-promo-banner__cta {
    display: inline-block;
    padding: 6px 20px 10px;
    background-color: var(--color-primary-hover);
    color: var(--color-background);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease;
    white-space: nowrap;
    margin-top: 4px;
  }

  .tooto-promo-banner__cta:hover {
    opacity: 0.85;
  }

  /* ── 响应式 ── */
  @media (max-width: 767px) {
    .tooto-promo-banner__inner {
      align-items: end;
      /* 由 JavaScript 动态设置移动端高度 */
    }
    .tooto-promo-banner__heading {
      font-size: 28px;
      line-height: 32px;
    }

    .tooto-promo-banner__content {
      gap: 8px;
      padding: 48px 20px;
    }

    .tooto-promo-banner__description {
      font-size: 13px;
      line-height: 17px;
      margin-bottom: 8px;
    }
    .tooto-promo-banner__cta {
      font-size: 13px;
      line-height: 1;
      padding: 11px 20px;
    }
    .tooto-promo-banner {
      min-height: 450px;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    const sectionEl = document.getElementById('tooto-promo-banner-{{ section.id }}');
    if (!sectionEl) return;

    const innerEl = sectionEl.querySelector('.tooto-promo-banner__inner');
    if (!innerEl) return;

    const mobileHeight = innerEl.dataset.mobileHeight;
    // 保底：如果没有配置移动端高度，就不做任何处理（使用桌面端高度）
    if (!mobileHeight) return;

    // 创建媒体查询监听
    const mediaQuery = window.matchMedia('(max-width: 767px)');

    function applyHeight(isMobile) {
      if (isMobile) {
        innerEl.style.minHeight = mobileHeight + 'vh';
      } else {
        // 桌面端恢复原始样式（由 CSS 变量设置）
        innerEl.style.minHeight = '';
      }
    }

    // 初始化
    applyHeight(mediaQuery.matches);

    // 响应窗口尺寸变化
    mediaQuery.addEventListener('change', (e) => {
      applyHeight(e.matches);
    });
  })();
</script>

{% schema %}
{
  "name": "Tooto Promo Banner",
  "tag": "section",
  "class": "tooto-promo-banner-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Background Image (Mobile)",
      "info": "Optional: If not set, desktop image will be used on mobile"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section Height - Desktop (vh)",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 55
    },
    {
      "type": "range",
      "id": "section_height_mobile",
      "label": "Section Height - Mobile (vh)",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 50
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Personalised For\nYour Home"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "With Our Tailored To Fit Wool Rugs, You Can Personalise Your Rug By Choosing The Style, Colour, Size, Shape & Edging Best Suited To Your Home."
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "Customize now"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Tooto Promo Banner",
      "settings": {
        "heading": "Personalised For\nYour Home",
        "description": "With Our Tailored To Fit Wool Rugs, You Can Personalise Your Rug By Choosing The Style, Colour, Size, Shape & Edging Best Suited To Your Home.",
        "cta_label": "Customize now",
        "overlay_opacity": 45,
        "section_height": 55,
        "section_height_mobile": 50,
        "section_width": "page-width",
        "color_scheme": "scheme-1"
      }
    }
  ]
}
{% endschema %}