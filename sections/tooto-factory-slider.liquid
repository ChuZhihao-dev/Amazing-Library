{%- liquid
  assign img_widths = '600, 900, 1200'
  assign img_sizes = '(min-width: 990px) 55vw, (min-width: 750px) 70vw, 90vw'
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  id="tooto-factory-slider-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} tooto-factory-slider"
  style="padding-block-start: {{ section.settings.padding-block-start }}px; padding-block-end: {{ section.settings.padding-block-end }}px;"
>
  <div class="tooto-factory-slider__inner">

    {%- comment -%} 顶部标题行 {%- endcomment -%}
    <div class="tooto-factory-slider__header">
      <h2 class="tooto-factory-slider__heading">
        {%- if section.settings.heading_bold != blank -%}
          <strong>{{ section.settings.heading_bold }}</strong>
        {%- endif -%}
        {%- if section.settings.heading_normal != blank -%}
          <span class="tooto-factory-slider__heading-light"> {{ section.settings.heading_normal }}</span>
        {%- endif -%}
      </h2>

      {%- comment -%} 顶部箭头按钮 {%- endcomment -%}
      <div class="tooto-factory-slider__nav">
        <button
          class="tooto-factory-slider__nav-btn tooto-factory-slider__nav-btn--prev"
          aria-label="Previous slide"
        >
          <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" width="23.978328704833984" height="16.77143096923828" viewBox="0 0 23.978328704833984 16.77143096923828"><path d="M47.66376070483398,7.7286453L39.63954670483398,0.2721754C39.249047704833984,-0.090725288,38.61585970483398,-0.090725288,38.22535870483399,0.2721754C37.83482870483398,0.63507611,37.83482870483398,1.2234361,38.22535870483399,1.5863373L44.57848170483398,7.4899735L24.942266104833983,7.4899735C24.409891334833983,7.4899735,23.978328704833984,7.8910317,23.978328704833984,8.3857117C23.978328704833984,8.8804216,24.409922334833983,9.2814503,24.942266104833983,9.2814503L44.57851370483398,9.2814503L38.22535870483399,15.185115C37.83482870483398,15.547986,37.83482870483398,16.136375,38.22535870483399,16.499277C38.42060870483398,16.680712,38.67654470483399,16.771431,38.93245370483398,16.771431C39.188359704833985,16.771431,39.444297704833986,16.680712,39.63954670483398,16.499277L47.66376470483398,9.0427771C48.05429070483399,8.6798935,48.05429070483399,8.0915308,47.66376070483398,7.7286453Z" fill-opacity="1" style="mix-blend-mode:passthrough" transform="matrix(-1,0,0,1,47.95665740966797,0)"/></svg>
        </button>
        <button
          class="tooto-factory-slider__nav-btn tooto-factory-slider__nav-btn--next"
          aria-label="Next slide"
        >
          <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" width="23.978328704833984" height="16.77143096923828" viewBox="0 0 23.978328704833984 16.77143096923828"><path d="M23.685432,7.7286453L15.661218,0.2721754C15.270719,-0.090725288,14.637531,-0.090725288,14.24703,0.2721754C13.8565,0.63507611,13.8565,1.2234361,14.24703,1.5863373L20.600153,7.4899735L0.9639374,7.4899735C0.43156263,7.4899735,0,7.8910317,0,8.3857117C0,8.8804216,0.43159363,9.2814503,0.9639374,9.2814503L20.600185,9.2814503L14.24703,15.185115C13.8565,15.547986,13.8565,16.136375,14.24703,16.499277C14.44228,16.680712,14.698216,16.771431,14.954125,16.771431C15.210031,16.771431,15.465969,16.680712,15.661218,16.499277L23.685436,9.0427771C24.075962,8.6798935,24.075962,8.0915308,23.685432,7.7286453Z" fill-opacity="1"/></svg>
        </button>
      </div>
    </div>

    {%- comment -%} Swiper 轮播 {%- endcomment -%}
    <div class="tooto-factory-slider__swiper-wrapper">
      <div class="swiper tooto-factory-slider__swiper">
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            <div class="swiper-slide tooto-factory-slider__slide" {{ block.shopify_attributes }}>
              <div class="tooto-factory-slider__image-wrapper">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      widths: img_widths,
                      sizes: img_sizes,
                      alt: block.settings.image.alt,
                      loading: 'lazy',
                      class: 'tooto-factory-slider__image'
                  }}
                {%- else -%}
                  {{ 'hero-apparel-1' | placeholder_svg_tag: 'tooto-factory-slider__image tooto-factory-slider__image--placeholder' }}
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} 图片上叠加的左右箭头 {%- endcomment -%}
      <button
        class="tooto-factory-slider__overlay-btn tooto-factory-slider__overlay-btn--prev"
        aria-label="Previous slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" width="23.978328704833984" height="16.77143096923828" viewBox="0 0 23.978328704833984 16.77143096923828"><path d="M47.66376070483398,7.7286453L39.63954670483398,0.2721754C39.249047704833984,-0.090725288,38.61585970483398,-0.090725288,38.22535870483399,0.2721754C37.83482870483398,0.63507611,37.83482870483398,1.2234361,38.22535870483399,1.5863373L44.57848170483398,7.4899735L24.942266104833983,7.4899735C24.409891334833983,7.4899735,23.978328704833984,7.8910317,23.978328704833984,8.3857117C23.978328704833984,8.8804216,24.409922334833983,9.2814503,24.942266104833983,9.2814503L44.57851370483398,9.2814503L38.22535870483399,15.185115C37.83482870483398,15.547986,37.83482870483398,16.136375,38.22535870483399,16.499277C38.42060870483398,16.680712,38.67654470483399,16.771431,38.93245370483398,16.771431C39.188359704833985,16.771431,39.444297704833986,16.680712,39.63954670483398,16.499277L47.66376470483398,9.0427771C48.05429070483399,8.6798935,48.05429070483399,8.0915308,47.66376070483398,7.7286453Z" fill-opacity="1" style="mix-blend-mode:passthrough" transform="matrix(-1,0,0,1,47.95665740966797,0)"/></svg>
      </button>
      <button
        class="tooto-factory-slider__overlay-btn tooto-factory-slider__overlay-btn--next"
        aria-label="Next slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" width="23.978328704833984" height="16.77143096923828" viewBox="0 0 23.978328704833984 16.77143096923828"><path d="M23.685432,7.7286453L15.661218,0.2721754C15.270719,-0.090725288,14.637531,-0.090725288,14.24703,0.2721754C13.8565,0.63507611,13.8565,1.2234361,14.24703,1.5863373L20.600153,7.4899735L0.9639374,7.4899735C0.43156263,7.4899735,0,7.8910317,0,8.3857117C0,8.8804216,0.43159363,9.2814503,0.9639374,9.2814503L20.600185,9.2814503L14.24703,15.185115C13.8565,15.547986,13.8565,16.136375,14.24703,16.499277C14.44228,16.680712,14.698216,16.771431,14.954125,16.771431C15.210031,16.771431,15.465969,16.680712,15.661218,16.499277L23.685436,9.0427771C24.075962,8.6798935,24.075962,8.0915308,23.685432,7.7286453Z" fill-opacity="1"/></svg>
      </button>
    </div>

  </div>
</div>

<script>
  (function () {
    var sectionEl = document.getElementById('tooto-factory-slider-{{ section.id }}');
    if (!sectionEl) return;

    document.addEventListener('DOMContentLoaded', function () {
      var swiperEl = sectionEl.querySelector('.tooto-factory-slider__swiper');
      if (!swiperEl) return;

      var swiper = new Swiper(swiperEl, {
        slidesPerView: 1.55,
        spaceBetween: 16,
        loop: false,
        grabCursor: true,
        breakpoints: {
          0: {
            slidesPerView: 1.1,
            spaceBetween: 12
          },
          750: {
            slidesPerView: 1.35,
            spaceBetween: 16
          },
          990: {
            slidesPerView: 1.55,
            spaceBetween: 20
          }
        }
      });

      /* 顶部箭头 */
      var prevBtns = sectionEl.querySelectorAll('.tooto-factory-slider__nav-btn--prev, .tooto-factory-slider__overlay-btn--prev');
      var nextBtns = sectionEl.querySelectorAll('.tooto-factory-slider__nav-btn--next, .tooto-factory-slider__overlay-btn--next');

      prevBtns.forEach(function (btn) {
        btn.addEventListener('click', function () { swiper.slidePrev(); });
      });
      nextBtns.forEach(function (btn) {
        btn.addEventListener('click', function () { swiper.slideNext(); });
      });
    });
  })();
</script>

{% stylesheet %}
  .tooto-factory-slider {
    overflow: hidden;
  }
  .tooto-factory-slider__inner {
    grid-column: 1 / -1;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .section--page-width .tooto-factory-slider__inner {
    grid-column: 2;
  }

  /* ── 顶部标题行 ── */
  .tooto-factory-slider__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .tooto-factory-slider__heading {
    font-size: 56px;
    line-height: 64px;
    margin: 0;
    color: var(--color-foreground-heading);
    max-width: 25%;
  }

  .tooto-factory-slider__heading strong {
    font-weight: 700;
  }

  .tooto-factory-slider__heading-light {
    font-weight: 275;
  }

  /* ── 顶部圆形箭头 ── */
  .tooto-factory-slider__nav {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .tooto-factory-slider__nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 36px;
    border-radius: 18px;
    border: 1px solid var(--color-foreground);
    background: transparent;
    color: var(--color-foreground);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .tooto-factory-slider__nav-btn:hover {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }
    .tooto-factory-slider__nav-btn:hover svg {
      fill: #fff;
    }
  /* ── Swiper 外层（截断效果）── */
  .tooto-factory-slider__swiper-wrapper {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  .tooto-factory-slider__swiper {
    width: 100%;
    min-width: 0;
    overflow: visible;
  }

  .tooto-factory-slider__swiper > .swiper-wrapper {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    box-sizing: content-box;
    position: relative;
    width: 100vw;
    height: 100%;
    z-index: 1;
    will-change: transform;
  }

  .tooto-factory-slider__swiper > .swiper-wrapper > .swiper-slide {
    flex-shrink: 0;
    width: 100%;
    height: auto;
    position: relative;
    display: block;
  }

  /* ── 图片 ── */
  .tooto-factory-slider__image-wrapper {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .tooto-factory-slider__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tooto-factory-slider__image--placeholder {
    width: 100%;
    height: 100%;
  }

  /* ── 图片叠加箭头按钮 ── */
  .tooto-factory-slider__overlay-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    background-color: rgba(255, 255, 255, 0.9);
    color: var(--color-foreground);
    cursor: pointer;
    z-index: 10;
    transition: background-color 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }

  .tooto-factory-slider__overlay-btn:hover {
    background-color: #000;
  }

  .tooto-factory-slider__overlay-btn:hover svg {
    fill: white;
  }

  .tooto-factory-slider__overlay-btn--prev {
    left: 16px;
  }

  .tooto-factory-slider__overlay-btn--next {
    right: 16px;
  }

  @media (max-width: 749px) {
    .tooto-factory-slider__overlay-btn {
      display: none;
    }
    .tooto-factory-slider {
      padding-block: 0 48px !important;
    }
    .tooto-factory-slider__heading{
      max-width: 50%;
      font-size: 28px;
      line-height: 32px;
    }
    .tooto-factory-slider__swiper {
      overflow: hidden;
    }
    .tooto-factory-slider__swiper > .swiper-wrapper {
      width: 100%;
    }
    .tooto-factory-slider__nav-btn {
      width: 32px;
      height: 18px;
    }
    .tooto-factory-slider__nav-btn svg {
      width: 12px;
      height: 8px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tooto Factory Slider",
  "tag": "section",
  "class": "tooto-factory-slider-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading_bold",
      "label": "Heading (Bold part)",
      "default": "Woo"
    },
    {
      "type": "text",
      "id": "heading_normal",
      "label": "Heading (Light part)",
      "default": "Own Factory"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tooto Factory Slider",
      "settings": {
        "heading_bold": "Woo",
        "heading_normal": "Own Factory",
        "section_width": "page-width",
        "color_scheme": "scheme-1",
        "padding-block-start": 48,
        "padding-block-end": 48
      },
      "blocks": [
        { "type": "slide", "settings": {} },
        { "type": "slide", "settings": {} },
        { "type": "slide", "settings": {} }
      ]
    }
  ]
}
{% endschema %}