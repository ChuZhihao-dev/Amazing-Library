{%- liquid
  assign img_widths = '600, 900, 1200'
  assign img_sizes = '(min-width: 990px) 55vw, (min-width: 750px) 70vw, 90vw'
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  id="tooto-factory-slider-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} tooto-factory-slider"
  style="padding-block-start: {{ section.settings.padding-block-start }}px; padding-block-end: {{ section.settings.padding-block-end }}px;"
>
  <div class="tooto-factory-slider__inner">

    {%- comment -%} 顶部标题行 {%- endcomment -%}
    <div class="tooto-factory-slider__header">
      <h2 class="tooto-factory-slider__heading">
        {%- if section.settings.heading_bold != blank -%}
          <strong>{{ section.settings.heading_bold }}</strong>
        {%- endif -%}
        {%- if section.settings.heading_normal != blank -%}
          <span class="tooto-factory-slider__heading-light"> {{ section.settings.heading_normal }}</span>
        {%- endif -%}
      </h2>

      {%- comment -%} 顶部箭头按钮 {%- endcomment -%}
      <div class="tooto-factory-slider__nav">
        <button
          class="tooto-factory-slider__nav-btn tooto-factory-slider__nav-btn--prev"
          aria-label="Previous slide"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button
          class="tooto-factory-slider__nav-btn tooto-factory-slider__nav-btn--next"
          aria-label="Next slide"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>

    {%- comment -%} Swiper 轮播 {%- endcomment -%}
    <div class="tooto-factory-slider__swiper-wrapper">
      <div class="swiper tooto-factory-slider__swiper">
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            <div class="swiper-slide tooto-factory-slider__slide" {{ block.shopify_attributes }}>
              <div class="tooto-factory-slider__image-wrapper">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      widths: img_widths,
                      sizes: img_sizes,
                      alt: block.settings.image.alt,
                      loading: 'lazy',
                      class: 'tooto-factory-slider__image'
                  }}
                {%- else -%}
                  {{ 'hero-apparel-1' | placeholder_svg_tag: 'tooto-factory-slider__image tooto-factory-slider__image--placeholder' }}
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} 图片上叠加的左右箭头 {%- endcomment -%}
      <button
        class="tooto-factory-slider__overlay-btn tooto-factory-slider__overlay-btn--prev"
        aria-label="Previous slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button
        class="tooto-factory-slider__overlay-btn tooto-factory-slider__overlay-btn--next"
        aria-label="Next slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

  </div>
</div>

<script>
  (function () {
    var sectionEl = document.getElementById('tooto-factory-slider-{{ section.id }}');
    if (!sectionEl) return;

    document.addEventListener('DOMContentLoaded', function () {
      var swiperEl = sectionEl.querySelector('.tooto-factory-slider__swiper');
      if (!swiperEl) return;

      var swiper = new Swiper(swiperEl, {
        slidesPerView: 1.55,
        spaceBetween: 16,
        loop: false,
        grabCursor: true,
        breakpoints: {
          0: {
            slidesPerView: 1.1,
            spaceBetween: 12
          },
          750: {
            slidesPerView: 1.35,
            spaceBetween: 16
          },
          990: {
            slidesPerView: 1.55,
            spaceBetween: 20
          }
        }
      });

      /* 顶部箭头 */
      var prevBtns = sectionEl.querySelectorAll('.tooto-factory-slider__nav-btn--prev, .tooto-factory-slider__overlay-btn--prev');
      var nextBtns = sectionEl.querySelectorAll('.tooto-factory-slider__nav-btn--next, .tooto-factory-slider__overlay-btn--next');

      prevBtns.forEach(function (btn) {
        btn.addEventListener('click', function () { swiper.slidePrev(); });
      });
      nextBtns.forEach(function (btn) {
        btn.addEventListener('click', function () { swiper.slideNext(); });
      });
    });
  })();
</script>

{% stylesheet %}
  .tooto-factory-slider__inner {
    grid-column: 1 / -1;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .section--page-width .tooto-factory-slider__inner {
    grid-column: 2;
  }

  /* ── 顶部标题行 ── */
  .tooto-factory-slider__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .tooto-factory-slider__heading {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
    margin: 0;
    color: var(--color-foreground-heading);
  }

  .tooto-factory-slider__heading strong {
    font-weight: 800;
  }

  .tooto-factory-slider__heading-light {
    font-weight: 300;
  }

  /* ── 顶部圆形箭头 ── */
  .tooto-factory-slider__nav {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    padding-top: 4px;
  }

  .tooto-factory-slider__nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid var(--color-foreground);
    background: transparent;
    color: var(--color-foreground);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .tooto-factory-slider__nav-btn:hover {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  /* ── Swiper 外层（截断效果）── */
  .tooto-factory-slider__swiper-wrapper {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  .tooto-factory-slider__swiper {
    width: 100%;
    min-width: 0;
    overflow: hidden;
  }

  .tooto-factory-slider__swiper > .swiper-wrapper {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    box-sizing: content-box;
    position: relative;
    width: 100%;
    height: 100%;
    z-index: 1;
    will-change: transform;
  }

  .tooto-factory-slider__swiper > .swiper-wrapper > .swiper-slide {
    flex-shrink: 0;
    width: 100%;
    height: auto;
    position: relative;
    display: block;
  }

  /* ── 图片 ── */
  .tooto-factory-slider__image-wrapper {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .tooto-factory-slider__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tooto-factory-slider__image--placeholder {
    width: 100%;
    height: 100%;
  }

  /* ── 图片叠加箭头按钮 ── */
  .tooto-factory-slider__overlay-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    background-color: rgba(255, 255, 255, 0.9);
    color: var(--color-foreground);
    cursor: pointer;
    z-index: 10;
    transition: background-color 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }

  .tooto-factory-slider__overlay-btn:hover {
    background-color: #ffffff;
  }

  .tooto-factory-slider__overlay-btn--prev {
    left: 16px;
  }

  .tooto-factory-slider__overlay-btn--next {
    right: 16px;
  }

  @media (max-width: 749px) {
    .tooto-factory-slider__overlay-btn {
      width: 40px;
      height: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tooto Factory Slider",
  "tag": "section",
  "class": "tooto-factory-slider-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading_bold",
      "label": "Heading (Bold part)",
      "default": "Woo"
    },
    {
      "type": "text",
      "id": "heading_normal",
      "label": "Heading (Light part)",
      "default": "Own Factory"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tooto Factory Slider",
      "settings": {
        "heading_bold": "Woo",
        "heading_normal": "Own Factory",
        "section_width": "page-width",
        "color_scheme": "scheme-1",
        "padding-block-start": 48,
        "padding-block-end": 48
      },
      "blocks": [
        { "type": "slide", "settings": {} },
        { "type": "slide", "settings": {} },
        { "type": "slide", "settings": {} }
      ]
    }
  ]
}
{% endschema %}