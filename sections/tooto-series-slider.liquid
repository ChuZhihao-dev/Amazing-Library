{%- liquid
  assign card_widths = '400, 600, 900'
  assign card_sizes = '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw'
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  id="tooto-series-slider-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} tooto-series-slider"
  style="padding-block-start: {{ section.settings.padding-block-start }}px; padding-block-end: {{ section.settings.padding-block-end }}px;"
>

  <div class="tooto-series-slider__inner">
  {%- comment -%} ── Header 区：两栏非等分 ── {%- endcomment -%}
  <div class="tooto-series-slider__header">
    <div class="tooto-series-slider__header-left">
      <h2 class="tooto-series-slider__heading">{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="tooto-series-slider__header-right">
      {%- if section.settings.description != blank -%}
        <p class="tooto-series-slider__description">{{ section.settings.description }}</p>
      {%- endif -%}
      {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
        <a class="tooto-series-slider__link" href="{{ section.settings.link_url }}">
          {{- section.settings.link_label }} &rarr;
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ── Swiper 轮播区 ── {%- endcomment -%}
  <div class="swiper tooto-series-slider__swiper">
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        <div class="swiper-slide tooto-series-slider__slide" {{ block.shopify_attributes }}>
          <a
            class="tooto-series-slider__card-link"
            {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
          >
            {%- comment -%} 图片区 {%- endcomment -%}
            <div class="tooto-series-slider__image-wrapper">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    widths: card_widths,
                    sizes: card_sizes,
                    alt: block.settings.image.alt,
                    loading: 'lazy',
                    class: 'tooto-series-slider__image'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'tooto-series-slider__image tooto-series-slider__image--placeholder' }}
              {%- endif -%}

              {%- comment -%} Badge ── 左上角胶囊标签 {%- endcomment -%}
              {%- if block.settings.badge != blank -%}
                <span class="tooto-series-slider__badge">{{ block.settings.badge | escape }}</span>
              {%- endif -%}
            </div>

            {%- comment -%} 卡片标题 {%- endcomment -%}
            {%- if block.settings.title != blank -%}
              <p class="tooto-series-slider__card-title">{{ block.settings.title | escape }}</p>
            {%- endif -%}
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} ── 横线型进度条（自定义 pagination） ── {%- endcomment -%}
  <div class="tooto-series-slider__pagination" id="tooto-series-pagination-{{ section.id }}"></div>

  </div>{%- comment -%} /__inner {%- endcomment -%}
</div>

<script>
  (function () {
    const sectionEl = document.getElementById('tooto-series-slider-{{ section.id }}');
    if (!sectionEl) return;

    const paginationEl = document.getElementById('tooto-series-pagination-{{ section.id }}');
    const swiperEl = sectionEl.querySelector('.tooto-series-slider__swiper');

    function buildPagination(swiper) {
      if (!paginationEl) return;
      var total = swiper.snapGrid.length;
      var current = swiper.snapIndex || 0;
      var html = '';
      for (var i = 0; i < total; i++) {
        var activeClass = i === current ? ' tooto-series-slider__dot--active' : '';
        html += '<button class="tooto-series-slider__dot' + activeClass + '" data-snap="' + i + '" aria-label="Go to page ' + (i + 1) + '"></button>';
      }
      paginationEl.innerHTML = html;
      paginationEl.querySelectorAll('.tooto-series-slider__dot').forEach(function (btn) {
        btn.addEventListener('click', function () {
          swiper.slideTo(swiper.snapGrid[parseInt(this.dataset.snap)]);
        });
      });
    }

    function updatePagination(swiper) {
      if (!paginationEl) return;
      var current = swiper.snapIndex || 0;
      paginationEl.querySelectorAll('.tooto-series-slider__dot').forEach(function (btn, i) {
        btn.classList.toggle('tooto-series-slider__dot--active', i === current);
      });
    }

    var swiper = new Swiper(swiperEl, {
      slidesPerView: 1,
      spaceBetween: 20,
      loop: false,
      slidesPerGroup: 1,
      speed: 500,

      breakpoints: {
        768: {
          slidesPerView: 2,
          spaceBetween: 20,
          slidesPerGroup: 2,
        },
        1024: {
          slidesPerView: 3,
          spaceBetween: 20,
          slidesPerGroup: 3,
        },
      },

      on: {
        init: function () {
          buildPagination(this);
        },
        snapIndexChange: function () {
          updatePagination(this);
        },
        breakpoint: function () {
          buildPagination(this);
        },
      },
    });
  })();
</script>

{% stylesheet %}
  /* ── 脱离主题 section grid，占满全部列 ── */
  .tooto-series-slider__inner {
    grid-column: 1 / -1;
    width: 100%;
    padding-inline: var(--page-margin, 20px);
    box-sizing: border-box;
  }

  .section--page-width .tooto-series-slider__inner {
    grid-column: 2;
    padding-inline: 0;
  }

  /* ── Swiper 核心布局（显式声明，防止主题 CSS 覆盖）── */
  .tooto-series-slider__swiper {
    overflow: hidden;
    width: 100%;
    min-width: 0;
    position: relative;
  }

  .tooto-series-slider__swiper > .swiper-wrapper {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    box-sizing: content-box;
    position: relative;
    width: 100%;
    height: 100%;
    z-index: 1;
    will-change: transform;
  }

  .tooto-series-slider__swiper > .swiper-wrapper > .swiper-slide {
    flex-shrink: 0;
    width: 100%;
    height: auto;
    position: relative;
    display: block;
  }

  /* ── Header 区 ── */
  .tooto-series-slider__header {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 60px;
    align-items: start;
    margin-bottom: 54px;
    padding-right: 40px;
  }

  .tooto-series-slider__heading {
    font-size: 56px;
    font-weight: 700;
    line-height: 64px;
    margin: 0;
    color: var(--color-foreground-heading);
  }

  .tooto-series-slider__header-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding-top: 4px;
  }

  .tooto-series-slider__description {
    font-size: 0.9rem;
    line-height: 1.65;
    margin: 0;
    color: var(--color-foreground);
  }

  .tooto-series-slider__link {
    font-size: 0.875rem;
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }

  .tooto-series-slider__link:hover {
    opacity: 0.6;
  }

  /* ── 卡片 ── */
  .tooto-series-slider__card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .tooto-series-slider__image-wrapper {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: rgba(var(--color-foreground-rgb), 0.05);
  }

  .tooto-series-slider__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
    will-change: transform;
  }

  .tooto-series-slider__card-link:hover .tooto-series-slider__image {
    transform: scale(1.05);
  }

  .tooto-series-slider__image--placeholder {
    width: 100%;
    height: 100%;
  }

  /* ── Badge ── */
  .tooto-series-slider__badge {
    position: absolute;
    top: 20px;
    left: 24px;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-background);
  }

  /* ── 卡片标题 ── */
  .tooto-series-slider__card-title {
    margin: 11px 0 0;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.4;
    color: var(--color-foreground);
  }

  /* ── 横线型进度条（覆盖 Swiper bullet 默认样式）── */
  .tooto-series-slider__pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0px;
    margin-top: 62px;
  }

  .tooto-series-slider__dot {
    width: 40px;
    height: 2px;
    border: none;
    border-radius: 2px;
    background-color: var(--color-foreground);
    opacity: 0.2;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
    transition: opacity 0.3s ease;
  }

  .tooto-series-slider__dot--active {
    opacity: 1;
  }

  /* ── 响应式 ── */
  @media (max-width: 1023px) {
    .tooto-series-slider__heading {
      font-size: 2rem;
    }
  }

  @media (max-width: 767px) {
    .tooto-series-slider__header {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 24px;
    }

    .tooto-series-slider__heading {
      font-size: 1.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tooto Series Slider",
  "tag": "section",
  "class": "tooto-series-slider-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Woo Cityofgems Slogn"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Made from natural animal fibers, wool carpets offer a soft, skin-friendly touch and a warm, inviting feel. Their inherent elasticity reduces foot fatigue, making them ideal for bedrooms or children's rooms."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "CTA Link Label",
      "default": "See More"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "CTA Link URL"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Label",
          "default": "Cloud Series"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Woo Carpet Series"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tooto Series Slider",
      "settings": {
        "color_scheme": "scheme-1"
      },
      "blocks": [
        { "type": "card", "settings": { "badge": "Cloud Series", "title": "Woo Carpet Series 1" } },
        { "type": "card", "settings": { "badge": "CityofGems", "title": "Woo Carpet Series 2" } },
        { "type": "card", "settings": { "badge": "Pathof Style", "title": "Woo Carpet Series 3" } },
        { "type": "card", "settings": { "badge": "New Series", "title": "Woo Carpet Series 4" } },
        { "type": "card", "settings": { "badge": "New Series", "title": "Woo Carpet Series 5" } },
        { "type": "card", "settings": { "badge": "New Series", "title": "Woo Carpet Series 6" } }
      ]
    }
  ]
}
{% endschema %}